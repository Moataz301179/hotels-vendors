# ═══════════════════════════════════════════════════════════════
# Hotels Vendors — Environment Variables (Swarm v3 — Ollama Primary)
# Copy this file to .env and fill in your real values
# ═══════════════════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://hotels_vendors:your_password@postgres:5433/hotels_vendors

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Session ──
SESSION_SECRET=change_this_to_a_32_character_random_string

# ═══════════════════════════════════════════════════════════════
# LLM PROVIDERS — Ollama is PRIMARY (zero cost, runs on VPS)
# Fallbacks are optional and only used when Ollama is down
# ═══════════════════════════════════════════════════════════════

# Option A: OLLAMA (PRIMARY — local/VPS, no API key needed)
# Runs inside Docker on the VPS. No external API calls.
# CPU VPS: use smaller models (llama3.2:3b, phi3:3.8b) for speed
# GPU VPS: use larger models (llama3.1:8b, phi4:14.7b) for quality
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Option B: GROQ (FREE TIER FALLBACK — 20 req/min, 1M tok/day)
# Get free key: https://console.groq.com
# No credit card required. Generous free tier.
GROQ_API_KEY=

# Option C: OPENROUTER (UNIVERSAL FALLBACK — $5-10 credits)
# Get from: https://openrouter.ai
OPENROUTER_API_KEY=

# Option D: KIMI via Moonshot (FUNDED FALLBACK — pay-as-you-go)
# Get from: https://platform.moonshot.ai
KIMI_API_KEY=

# Option E: Grok via xAI (FUNDED FALLBACK — pay-as-you-go)
# Get from: https://console.x.ai
XAI_API_KEY=

# ── Internal Services ──
OPENCLAW_URL=http://openclaw:8000
AGENT0_URL=http://agent0:9000

# ── Email (SendGrid recommended) ──
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=
EMAIL_FROM=noreply@hotelsvendors.com

# ── WhatsApp / Twilio ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── App URL (for OpenRouter referrer) ──
APP_URL=https://hotelsvendors.com
