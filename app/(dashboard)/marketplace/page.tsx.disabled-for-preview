"use client";

import { useState } from "react";
import { registry } from "@/lib/agos/registry";

const MarketplacePage = () => {
  const [selectedAgent, setSelectedAgent] = useState("");
  const [filter, setFilter] = useState("all");
  const [searchQuery, setSearchQuery] = useState("");
  const [modalOpen, setModalOpen] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);

  const agents = registry.getAgents();
  const tools = registry.getTools();
  const skills = registry.getSkills();

  const filteredAgents = agents.filter(agent => 
    selectedAgent === "" || agent.name === selectedAgent
  ).filter(agent => 
    searchQuery === "" || 
    agent.description.toLowerCase().includes(searchQuery.toLowerCase())
  );

  if (selectedAgent !== "") {
    const agent = agents.find(a => a.id === selectedAgent);
    if (agent) {
      setSelectedAgent(agent.name);
    }
  }

  const handleEdit = (id: string) => {
    setEditingId(id);
    setModalOpen(true);
  };

  const handleSave = async () => {
    if (!editingId) return;

    const agent = agents.find(a => a.id === editingId);
    if (agent) {
      // In a real app, this would call an API
      console.log("Saving edited agent:", agent);
    }

    setModalOpen(false);
    setEditingId(null);
  };

  const handleDelete = async (id: string) => {
    // In a real app, this would call API
    console.log("Deleting agent:", id);
  };

  return (
    <div className="p-6 bg-gray-900 text-white">
      <h1 className="text-2xl font-bold text-gray-200 mb-4">Agent Marketplace</h1>

      <div className="flex mb-4">
        <input
          type="text"
          placeholder="Search agents..."
          onChange={e => setSearchQuery(e.target.value)}
          className="p-2 rounded bg-gray-800 border border-gray-700 text-white w-full"
        />
        <select
          value={selectedAgent}
          onChange={e => setSelectedAgent(e.target.value)}
          className="p-2 rounded bg-gray-800 border border-gray-700 text-white w-64"
        >
          <option value="">All Agents</option>
          {agents.map(agent => (
            <option key={agent.id} value={agent.id}>
              {agent.name}
            </option>
          )}
          <option value="">--- Filter By Type ---</option>
          {["agent", "tool", "skill"].map(type => (
            <option key={type} value={type}>{type}</option>
          ]}
        </select>
      </div>

      {selectedAgent !== "" && <div className="bg-gray-800 rounded-lg p-4 mb-4">
        <h2 className="text-xl font-semibold mb-2">Details</h2>
        <p className="text-sm">{agents.find(a => a.id === selectedAgent)?.description}</p>
      </div>}

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        {agents.map(agent => (
          <div key={agent.id} className="bg-gray-800 rounded-lg p-4 hover:bg-gray-700 transition">
            <div className="flex items-center justify-between">
              <strong className="text-lg">{agent.name}</strong>
              <span className="text-xs bg-blue-500 px-2 py-1 rounded text-white">
                {agent.type}
              </span>
            </div>
            {agent.description && (
              <p className="text-sm text-gray-400 mt-1">{agent.description}</p>
            )}
            <div className="flex gap-2 mt-2">
              <button
                onClick={() => handleEdit(agent.id)}
                className="text-yellow-400 hover:text-yellow-300"
              >
                ✎
              </button>
              <button
                onClick={() => handleDelete(agent.id)}
                className="text-red-400 hover:text-red-300"
              >
                ❌
              </button>
            </div>
          </div>
        ))}
      </div>

      {/* Modal Form */}
      {modalOpen && editingId && (
        <div className="fixed inset-0 bg-black bg-opacity-20 flex items-center justify-center p-4">
          <div className="bg-gray-800 rounded-lg p-6 w-full max-w-md mx-auto">
            <h2 className="text-xl font-semibold mb-4">Edit Agent</h2>
            <div className="space-y-3">
              <div>
                <label className="block text-sm font-medium">Name</label>
                <input
                  value={agents.find(a => a.id === editingId)?.name || ""}
                  onChange={e => {}}
                  className="w-full bg-gray-700 text-white border border-gray-700 rounded px-3 py-2"
                />
              </div>
              <div>
                <label className="block text-sm font-medium">Description</label>
                <textarea
                  value={agents.find(a => a.id === editingId)?.description || ""}
                  onChange={e => {}}
                  className="w-full bg-gray-700 text-white border border-gray-700 rounded p-3"
                />
              </div>
            </div>
            <div className="flex justify-end">
              <button
                onClick={() => setModalOpen(false)}
                className="bg-gray-600 hover:bg-gray-700 px-4 py-2 rounded"
              >
                Cancel
              </button>
              <button
                onClick={handleSave}
                className="bg-green-600 hover:bg-green-700 px-4 py-2 rounded ml-2"
              >
                Save
              </button>
            </div>
          </div>
        </div>
      )}

      <button
        onClick={() => setModalOpen(true)}
        className="mt-4 bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded text-white"
      >
        ➕ Register New Agent
      </button>
    </div>
  );
};

export default MarketplacePage;