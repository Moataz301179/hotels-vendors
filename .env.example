# ── HotelsVendors — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in values. Secrets use "REPLACE_ME" placeholders.
# Non-sensitive dev defaults are provided where applicable.

# ── Core ──────────────────────────────────────────────────────────────────────

# Prisma database connection string (sqlite for dev, postgres for prod)
DATABASE_URL="file:./dev.db"

# JWT session signing secret (must be 32+ random bytes in production)
SESSION_SECRET="dev-secret-change-in-production"

# AES-256-GCM key for encrypting PII at rest (hex-encoded 32 bytes)
PII_ENCRYPTION_KEY="REPLACE_ME"

# ── App URLs ──────────────────────────────────────────────────────────────────

# Public-facing base URL (used in email links, CORS origin, etc.)
NEXT_PUBLIC_APP_URL="https://hotelsvendors.com"

# Internal server-side base URL (for server-to-server API calls)
APP_URL="http://localhost:3000"

# VPS-hosted AI assistant URL (hybrid deploy: AI on separate VPS)
NEXT_PUBLIC_VPS_API_URL=""

# VPS API URL (server-side only, used when VPS hosts AI endpoints)
VPS_API_URL=""

# ── ETA — Egyptian Tax Authority E-Invoicing ──────────────────────────────────

# ETA REST API base URL (preprod for staging, prod for production)
ETA_API_URL="https://api.preprod.invoicing.eta.gov.eg"

# ETA OAuth/token issuer URL
ETA_AUTH_URL="https://id.preprod.eta.gov.eg"

# ETA OAuth2 client credentials
ETA_CLIENT_ID="REPLACE_ME"
ETA_CLIENT_SECRET="REPLACE_ME"

# AES encryption key for ETA document submission
ETA_ENCRYPTION_KEY="REPLACE_ME"

# ETA webhook signing secret (verifies callback authenticity)
ETA_WEBHOOK_SECRET="REPLACE_ME"

# PKCS#11 smart-card driver path for ETA digital signing
PKCS11_DRIVER_PATH="/usr/lib/libepskey.so"

# ETA hardware token PIN
ETA_HARDWARE_PIN="REPLACE_ME"

# Set to "true" to stub ETA calls (auto-enabled when ETA_CLIENT_ID is empty)
ETA_STUB_MODE="true"

# ── Paymob — Payment Gateway ──────────────────────────────────────────────────

PAYMOB_API_KEY="REPLACE_ME"
PAYMOB_PUBLIC_KEY="REPLACE_ME"
PAYMOB_SECRET_KEY="REPLACE_ME"
PAYMOB_INTEGRATION_ID="REPLACE_ME"
PAYMOB_IFRAME_ID="REPLACE_ME"
PAYMOB_IFRAME_BASE_URL="https://accept.paymob.com"

# ── Fawry — Payment Gateway ──────────────────────────────────────────────────

FAWRY_BASE_URL="https://atfawry.com/api/ECommerceWeb/Fawry"
FAWRY_MERCHANT_CODE="REPLACE_ME"
FAWRY_SECRET="REPLACE_ME"
FAWRY_MOCK="true"

# ── InstaPay — Payment Gateway ───────────────────────────────────────────────

INSTAPAY_BASE_URL="https://api.instapay.dev/v1"
INSTAPAY_API_KEY="REPLACE_ME"
INSTAPAY_SECRET="REPLACE_ME"
INSTAPAY_MOCK="true"

# ── OLIV — Factoring / Receivables Finance ────────────────────────────────────

OLIV_API_URL="https://api.oliv.finance/v1"
OLIV_API_KEY="REPLACE_ME"
OLIV_MOCK="true"

# ── Email — Resend ───────────────────────────────────────────────────────────

RESEND_API_KEY="REPLACE_ME"
FROM_EMAIL="noreply@hotelsvendors.com"

# ── Twilio — SMS & WhatsApp ──────────────────────────────────────────────────

TWILIO_ACCOUNT_SID="REPLACE_ME"
TWILIO_AUTH_TOKEN="REPLACE_ME"
TWILIO_WHATSAPP_FROM="REPLACE_ME"

# WhatsApp provider: "meta" (Cloud API) or "twilio"
WHATSAPP_PROVIDER="meta"

# ── AI / LLM Providers ──────────────────────────────────────────────────────

# OpenRouter API key (primary cloud LLM route)
OPENROUTER_API_KEY="REPLACE_ME"
OPENROUTER_MODEL="openrouter/owl-alpha"

# Local Ollama instance (dev fallback)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# ── Smart Settlement Worker ──────────────────────────────────────────────────

# Set to "true" to start the background settlement worker on server boot
SMART_SETTLEMENT_WORKER="false"

# ── Factoring Overrides (dev only) ───────────────────────────────────────────

# Bypass four-eyes approval in development
BYPASS_FOUR_EYES="true"

# Override treasury limits for testing
TREASURY_OVERRIDE="false"

# ── API Key Authentication ───────────────────────────────────────────────────

# JSON array of { key, secret } objects for API-key auth (used by INVO routes)
# Example: API_KEYS='[{"key":"invo-partner-1","secret":"REPLACE_ME"}]'
API_KEYS=""

# ── HashiCorp Vault (optional, for secrets management) ───────────────────────

VAULT_ADDR=""
VAULT_TOKEN=""

# ── Exchange Rate Widget (public, client-side) ──────────────────────────────

NEXT_PUBLIC_EXCHANGE_API_KEY="REPLACE_ME"
