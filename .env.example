# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hotels_vendors?schema=public"

# JWT — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-random-secret"

# SMTP (email verification)
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="your@email.com"
SMTP_PASS="your-password"
EMAIL_FROM="HotelProcure <noreply@hotelsvendors.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fintech — set to "true" to use sandbox/test modes for all payment providers
# When enabled, Paymob uses test API keys and Oliv uses mock status transitions
# No real financial transactions are executed in sandbox mode
NEXT_PUBLIC_FINTECH_SANDBOX="true"

# Paymob (live credentials — only used when NEXT_PUBLIC_FINTECH_SANDBOX is "false")
# Sandbox keys are available at https://accept.paymob.com/portal2/sandbox
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""

# Oliv Finance (live credentials — only used when NEXT_PUBLIC_FINTECH_SANDBOX is "false")
OLIV_API_KEY=""
OLIV_API_SECRET=""
OLIV_BASE_URL="https://api.olivfinance.com"
