# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hotels_vendors?schema=public&connection_limit=10&pool_timeout=30"

# PostgreSQL connection pool (used by lib/prisma.ts)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# Redis — set only when running with a real Redis instance.
# Leave empty for local build/static generation without a cache.
REDIS_PASSWORD=""
REDIS_URL=""

# Session / JWT — generate with: openssl rand -hex 32
# MUST be set in production — app crashes without it
SESSION_SECRET="replace-with-random-64-char-hex-string"

# SMTP (email verification + notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="your@email.com"
SMTP_PASS="your-password"
EMAIL_FROM="HotelProcure <noreply@hotelsvendors.com>"

# Supabase (for auth if using Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fintech — set to "true" to use sandbox/test modes for all payment providers
# When enabled, Paymob uses test API keys and Oliv uses mock status transitions
# No real financial transactions are executed in sandbox mode
NEXT_PUBLIC_FINTECH_SANDBOX="true"

# Paymob (live credentials — only used when NEXT_PUBLIC_FINTECH_SANDBOX is "false")
# Sandbox keys are available at https://accept.paymob.com/portal2/sandbox
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""

# Oliv Finance (live credentials — only used when NEXT_PUBLIC_FINTECH_SANDBOX is "false")
OLIV_API_KEY=""
OLIV_API_SECRET=""
OLIV_BASE_URL="https://api.olivfinance.com"
OLIV_WEBHOOK_SECRET=""
OLIV_CLIENT_ID=""

# Oliv Anti-Bypass HMAC — generate with: openssl rand -base64 32 (MUST be >= 32 chars)
HOTELSVENDORS_HMAC_SECRET="replace-with-random-base64-string-at-least-32-chars"

# AI Swarm — Ollama is PRIMARY (zero cost, zero rate limits), others are fallbacks
# Local dev: http://localhost:11434
# Docker Compose: http://ollama:11434
# VPS (production): http://187.77.181.3:11434
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
KIMI_API_KEY=""
XAI_API_KEY=""

# Sentry (error tracking + performance monitoring)
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
