# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hotels_vendors?schema=public"

# JWT — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-random-secret"

# Session — generate with: openssl rand -hex 32
# REQUIRED in production (lib/session.ts hard-fails without it)
SESSION_SECRET="replace-with-random-hex-secret"

# SMTP (email verification)
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="your@email.com"
SMTP_PASS="your-password"
EMAIL_FROM="HotelProcure <noreply@hotelsvendors.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis (rate limiting, session blacklist, job queues)
REDIS_URL="redis://localhost:6379"

# Ollama (swarm LLM — primary, zero-cost)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Groq (fallback LLM provider)
# GROQ_API_KEY="gsk_..."

# Paymob (payment integration)
# PAYMOB_API_KEY="..."
# PAYMOB_HMAC_SECRET="..."

# Twilio (SMS OTP, WhatsApp)
# TWILIO_ACCOUNT_SID="..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+20..."

# Sentry (error tracking)
# SENTRY_DSN="..."

# ETA (Egyptian Tax Authority e-invoicing)
# ETA_CLIENT_ID="..."
# ETA_CLIENT_SECRET="..."
