<style> 
	body{
		width: 100%;
	
	}
	
	
	.top_panel_default /*.top_panel_navi*/{
		padding: 0px 80px !important;
	
		
	}
		


	.page_content_wrap{
	 background-color: #ffffff !important;
	}
	
	
	
