<style type="text/css">
	.cta-modal-button a {
		box-shadow: 0px 0px 2px 2px gray;
	}
	.selectclass {
		width: 80% !important; 
	}

	.cta-modal {
		max-width: 750px !important;
		border-radius: 20px;
		padding: 20px;
		border: 2px solid lightgrey;
		margin: 50px auto;
		min-height: 165px;
		display: flex;
		flex-direction: column;
		flex-wrap: nowrap;
		align-content: center;
		justify-content: center;
		align-items: center;
		background-color: white;
		position: relative;
		width: 50%;
		min-width: 600px;
		min-height: 600px;
		box-shadow: 0px 0px 3px 3px #0000004a;
	}

	.cta-modal-container {
		position: fixed;
		width: 100%;
		height: 100%;
		left: 0;
		top: 0;
		display: flex;
		flex-direction: column;
		flex-wrap: nowrap;
		align-content: center;
		justify-content: center;
		align-items: center;
		cursor: pointer;
		z-index: 2000;
		display: none;
		z-index: 99999999999999999;
		overflow-y: auto;
	}

	.cta-close {
		position: absolute;
		top: 10px;
		right: 15px;
		font-size: 23px;
		font-weight: 700;
		border: 1px solid;
		padding: 4px 9px;
		border-radius: 107px;
	}

	.cta-close:hover {
		background: #00699c;
		color: white;
	}

	.cta-closer {
		background: #00000078;
		width: 100%;
		height: 100%;
		position: fixed;
	}

	#cta-button {
		color: white;
		border-radius: 8px;
		margin-top: 20px;
		text-align: center;
		width: auto !important;
	}


	.cta-modal div {
		width: 100%;
		text-align: left;
		display: flex;
		flex-direction: row;
		align-content: center;
		justify-content: center;
		align-items: center;
		margin-bottom: 20px;
	}

	.cta-modal div label {
		width: 20%;

	}

	.cta-modal div input,
	.cta-modal div select {
		width: 80%;
		color: gray !important;
	}

	.cta-modal div input[type="button"]:disabled {
		background-color: lightgray !important;
	}

	.cta-modal input {
		width: 100%;
	}

	.cta-modal-button {
		cursor: pointer;
	}

	@media only screen and (max-width: 600px) {
		.cta-modal {
			width: 80%;
			min-width: inherit;
		}

		.cta-modal div label {
			width: 30%;
		}

		.cta-modal div input {
			width: 70%;
		}
	}
</style>




