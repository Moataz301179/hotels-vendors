<script type="text/javascript">
	function validateEmail(email) {
		var regex = /^\w+([.-]?\w+)*@\w+([.-]?\w+)*(\.\w{2,3})+$/;
		return regex.test(email);
	}

	function ValidateForm() {
		jQuery("#cta-button").attr('disabled', 'disabled');

		if (jQuery("#Name").val() == "") {
			jQuery("#Name").attr("style", "border:2px solid red");
			return false;
		} else {
			jQuery("#Name").removeAttr("style");
		}

		if (jQuery("#Mobile").val().length != 11) {
			jQuery("#Mobile").attr("style", "border:2px solid red");
			return false;
		} else {
			jQuery("#Mobile").removeAttr("style");
		}

		if (Number(jQuery("#Mobile").val()) == null) {
			jQuery("#Mobile").attr("style", "border:2px solid red");
			return false;
		} else {
			jQuery("#Mobile").removeAttr("style");
		}
		if (!validateEmail(jQuery("#Email").val())) {
			jQuery("#Email").attr("style", "border:2px solid red");
			return false;
		} else {
			jQuery("#Email").removeAttr("style");
		}

		

			if (jQuery("#BusinessName").val() == "") {
				jQuery("#BusinessName").attr("style", "border:2px solid red");
				return false;
			} else {
				jQuery("#BusinessName").removeAttr("style");
			}


		
		jQuery("#cta-button").removeAttr("disabled");
	}
</script>
	<div class="cta-modal-container">
		<div class="cta-closer"></div>
		<div class="cta-modal">
			<span class="cta-close">X</span>
			<h3>Fill the form</h3>
			<div>
				<label>Name*:</label>
				<input type="text" id="Name" name="Name" onkeyup="ValidateForm()" />
			</div>
			<input type="hidden" id="current_url" name="current_url" value="" />
			<input type="hidden" id="current_id" name="current_id" value="0" />
			<input type="hidden" id="current_title" name="current_title" value="" />
			<div>
				<label>Mobile*:</label>
				<input type="tel" id="Mobile" name="Mobile" onkeyup="ValidateForm()" />
			</div>
			<div>
				<label>Email*:</label>
				<input type="email" id="Email" name="Email" onkeyup="ValidateForm()" />
			</div>

			<div>
				<label>Job Title*:</label>
				<input type="text" id="JobTitle" name="JobTitle" onkeyup="ValidateForm()" />
			</div>

			<div>
				<label>Business Name*:</label>
				<input type="text" id="BusinessName" name="BusinessName" onkeyup="ValidateForm()" />
			</div>
						<div>
				<label>Business Type*:</label>
				<div class="select_container selectclass">
					<select id="BusinessType" name="BusinessType">
						<option value="Individual">Individual</option>
						<option value="Corporate">Corporate</option>
					</select>
				</div>
			</div>
			<div id="messagesuccesspopup" style="color: green;font-weight: 700;display: none;">Your Submission has been received.</div>
			<div>
				<input id="cta-button" style='color:#00699c!important' type="button" value="Submit" disabled="disabled" />
			</div>
		</div>
	</div>


