// Hotels Vendors — Digital Procurement Marketplace + Compliance Automation
// PostgreSQL + Multi-tenant schema
// Last updated: 2026-06-07
//
// ⚠️  LEGAL CONSTRAINT: This platform does NOT hold or transfer cash.
// The platform operator holds a DIGITAL MARKETING license only.
// All financial services (factoring, credit, payments) are operated by
// licensed third-party partners. The platform only charges:
//   1. SaaS subscription fees (supplier listing plans via INVO)
//   2. Document processing fees (ETA invoice submission per-document)
//   3. Marketplace commission on transactions (not financial spreads)
// No factoring fees, no cash custody, no lending, no wallet balances.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// TENANT — Multi-tenant isolation root
// ─────────────────────────────────────────

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  type         TenantType   @default(HOTEL_GROUP)
  status       TenantStatus @default(ACTIVE)
  taxId        String?      @unique
  logoUrl      String?
  primaryColor String?

  // Relations
  users          User[]
  hotels         Hotel[]
  suppliers      Supplier[]
  products       Product[]
  orders         Order[]
  invoices       Invoice[]
  auditLogs      AuditLog[]
  documents      Document[]
  carts          Cart[]
  journalEntries JournalEntry[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  roles                Role[]
  properties           Property[]
  deliveryZones        DeliveryZone[]
  spendRecords         SpendRecord[]
  inventorySnapshots   InventorySnapshot[]
  factoringCompanies   FactoringCompany[]
  creditTransactions   CreditTransaction[]
  factoringRequests    FactoringRequest[]
  logisticsHubs        LogisticsHub[]
  trips                Trip[]
  tripStops            TripStop[]
  outlets              Outlet[]
  supplierAudits       SupplierAudit[]
  payments             Payment[]
  creditFacilities     CreditFacility[]
  consolidatedOrders   ConsolidatedOrder[]
  consolidatedInvoices ConsolidatedInvoice[]
  hotelSuppliers       HotelSupplier[]

  // ── [NEW] Growth Engine ──
  promoCodes PromoCode[]

  // ── [NEW] Arbitration ──
  disputes Dispute[]

  // ── [NEW] INVO Subscriptions (SaaS, not financial) ──
  invoSubscriptions   InvoSubscription[]
  documentProcessings DocumentProcessing[]

  // ── [NEW] KYC/AML Compliance (Tenant-level) ──
  kycLevel      Int       @default(0)
  kycStatus     String    @default("NOT_STARTED")
  kycVerifiedAt DateTime?

  // ── [NEW] Tenant isolation for AgentRun + SwarmJob ──
  agentRuns           AgentRun[]
  swarmJobs           SwarmJob[]
  paymentTransactions PaymentTransaction[]
  etaCredential       EtaCredential?

  // ── [NEW] Refresh Token Rotation ──
  refreshTokens RefreshToken[]
}

enum TenantType {
  HOTEL_GROUP
  SUPPLIER
  FACTORING_COMPANY
  SHIPPING_PROVIDER
  PLATFORM
}

enum TenantStatus {
  ACTIVE
  ACTIVE_DEMO
  INACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────
// ROLE & PERMISSION — Granular RBAC
// ─────────────────────────────────────────

model Role {
  id              String           @id @default(cuid())
  name            String
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isGlobal        Boolean          @default(false)
  permissions     Permission[]
  users           User[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  roles           Role[]
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────
// 1. HOTELS (Buyers)
// ─────────────────────────────────────────

model Hotel {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  legalName     String?
  taxId         String  @unique // ETA Tax Registration Number
  commercialReg String?
  address       String?
  city          String
  governorate   String
  phone         String?
  email         String?
  starRating    Int? // 3, 4, 5, etc.

  roomCount   Int?
  tier        HotelTier   @default(CORE)
  status      HotelStatus @default(ACTIVE)
  creditLimit Float?
  creditUsed  Float?      @default(0)

  // Risk scoring
  riskScore Int?      @default(50) // 0-100, higher = riskier
  riskTier  RiskTier? @default(MEDIUM)

  // Relations
  properties     Property[]
  users          User[]
  orders         Order[]
  invoices       Invoice[]
  spendRecords   SpendRecord[]
  journalEntries JournalEntry[]
  carts          Cart[]

  consolidatedInvoices ConsolidatedInvoice[]
  mandatedSuppliers    HotelSupplier[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditTransactions CreditTransaction[]
  creditFacilities   CreditFacility[]
  tripStops          TripStop[]
  payments           Payment[]
}

model Property {
  id          String       @id @default(cuid())
  name        String
  address     String
  city        String
  governorate String
  roomCount   Int?
  type        PropertyType @default(HOTEL)

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  outlets Outlet[]
  orders  Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HotelRiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HotelTier {
  CORE
  PREMIER
  COASTAL
}

enum HotelStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PropertyType {
  HOTEL
  RESORT
  SERVICE_APARTMENT
  BOUTIQUE
}

// ─────────────────────────────────────────
// 2. USERS (Authority Matrix Actors)
// ─────────────────────────────────────────

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String
  companyName String?
  phone       String?
  role        UserRole    @default(DEPARTMENT_HEAD)
  status      UserStatus  @default(ACTIVE)
  sector      UserSector?

  // Auth
  passwordHash String?

  // Platform role
  platformRole PlatformRole @default(HOTEL)

  // Tenant & RBAC
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId       String
  assignedRole Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Actor relations
  hotelId String?
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  factoringCompanyId String?
  factoringCompany   FactoringCompany? @relation(fields: [factoringCompanyId], references: [id], onDelete: SetNull)

  // Authority Matrix
  canOverride Boolean @default(false)

  // Delegate invite
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  invitedBy       String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals  OrderApproval[]
  carts      Cart[]
  lastActive DateTime?
  orders     Order[]

  accountType     AccountType @default(BUSINESS)
  emailVerifiedAt DateTime?

  // Consent & Privacy (PDPL Art. 5, 6, 13)
  marketingConsent    Boolean  @default(false)
  termsAcceptedAt     DateTime?
  privacyPolicyVersion String?

  // ── [NEW] KYC/AML Compliance ──
  kycLevel       Int       @default(0) // 0=not started, 1,2,3 = verified level
  kycStatus      String    @default("NOT_STARTED") // NOT_STARTED, LEVEL_1_PENDING, LEVEL_1_VERIFIED, etc.
  kycVerifiedAt  DateTime?

  conversations  Conversation[]
  aiUsage        AiUsage?
  addresses      UserAddress[]
  reviews        ProductReview[]
  sampleRequests SampleRequest[]
  refreshTokens  RefreshToken[]

  @@index([sector])
}

enum UserRole {
  OWNER
  REGIONAL_GM
  GM
  FINANCIAL_CONTROLLER
  DEPARTMENT_HEAD
  CLERK
  RECEIVING_CLERK
}

enum PlatformRole {
  HOTEL
  SUPPLIER
  FACTORING
  SHIPPING
  ADMIN
  MARKETING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserSector {
  PROCUREMENT
  CASHFLOW
  FINTECH
  AI
  HOTEL
  SUPPLIER
  FACTORING
  LOGISTICS
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

// ─────────────────────────────────────────
// 3. SUPPLIERS (Sellers)
// ─────────────────────────────────────────

model Supplier {
  id            String  @id @default(cuid())
  name          String
  legalName     String?
  taxId         String  @unique
  commercialReg String?
  address       String?
  city          String
  governorate   String

  phone   String?
  email   String  @unique
  website String?

  description String?
  logoUrl     String?

  status           SupplierStatus @default(PENDING)
  tier             SupplierTier   @default(CORE)
  type             SupplierType   @default(WHOLESALER)
  isVerified       Boolean        @default(false)
  returnPolicyDays Int            @default(14)
  rating           Float?         @default(0)
  reviewCount      Int            @default(0)

  certifications String?

  bankAccount String?
  bankName    String?

  // ── INVO SaaS Subscription (replaces old saasSubscriptionPlan) ──
  invoSubscription InvoSubscription?

  products      Product[]
  orders        Order[]
  invoices      Invoice[]
  audits        SupplierAudit[]
  users         User[]
  hotelMandates HotelSupplier[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deliveryZones DeliveryZone[]

  // Document processing records
  documentProcessings DocumentProcessing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryZone {
  id      String @id @default(cuid())
  zone    String
  minDays Int
  maxDays Int
  fee     Float

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum SupplierStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SupplierTier {
  CORE
  PREMIER
  COASTAL
  VERIFIED
}

enum SupplierType {
  FACTORY
  WHOLESALER
  RETAILER
}

// ─────────────────────────────────────────
// 4. PRODUCTS (Catalog)
// ─────────────────────────────────────────

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  description String?
  category    ProductCategory
  subcategory String?

  unitPrice Float
  currency  String @default("EGP")

  volumeTiers String?

  stockQuantity Int       @default(0)
  minOrderQty   Int       @default(1)
  leadTimeDays  Int       @default(1)
  reorderPoint  Int       @default(10)
  reorderQty    Int       @default(50)
  avgDailyUsage Float     @default(0)
  lastCountedAt DateTime?
  aiForecast    String?

  unitOfMeasure  String  @default("piece")
  shelfLifeDays  Int?
  temperatureReq String?

  images String?
  specs  String?

  status ProductStatus @default(ACTIVE)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderItems         OrderItem[]
  inventorySnapshots InventorySnapshot[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cartItems CartItem[]
  reviews   ProductReview[]
}

enum ProductCategory {
  F_AND_B
  CONSUMABLES
  GUEST_SUPPLIES
  FFE
  SERVICES
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

// ─────────────────────────────────────────
// 5. ORDERS (Purchase Orders)
// ─────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  status OrderStatus @default(DRAFT)

  subtotal  Float
  vatAmount Float
  total     Float
  currency  String @default("EGP")

  deliveryDate         DateTime?
  deliveryInstructions String?

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items     OrderItem[]
  approvals OrderApproval[]
  invoices  Invoice[]

  etaSubmissionId String? @unique

  // Payment guarantee (operated by licensed third-party, not platform)
  paymentGuaranteed      Boolean   @default(false)
  paymentGuaranteeMethod String? // FACTORING_PARTNER, DIRECT, WAIVED
  paymentGuaranteeSetAt  DateTime?

  checkoutGroupId   String?
  shippingMethod    String?
  shippingCost      Float?    @default(0)
  estimatedDelivery DateTime?

  poNumber        String?
  costCenter      String?
  deliveryAddress String?

  disputes Dispute[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditTransactions CreditTransaction[]
  tripStops          TripStop[]
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Float
  total     Float

  receivedQuantity Int?
  returnedQuantity Int?    @default(0)
  returnReason     String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  notes String?
}

model OrderApproval {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])

  action ApprovalAction
  reason String?

  beforeState String?
  afterState  String?

  createdAt DateTime @default(now())

  @@index([orderId, approverId])
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
  IN_TRANSIT
  PARTIALLY_DELIVERED
  DELIVERED
  DISPUTED
  CANCELLED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  ESCALATED
  AUTO_APPROVED
  ADMIN_OVERRIDE
}

// ─────────────────────────────────────────
// 6. INVOICES (ETA E-Invoicing)
// ─────────────────────────────────────────

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  // ETA Compliance
  etaUuid          String?   @unique
  etaStatus        EtaStatus @default(PENDING)
  digitalSignature String?
  submissionLog    String?

  // ETA Dual-Language Fields (bilingual invoice line items per ETA V2 spec)
  codeName    String? // Product/service code name (English)
  codeNameAr  String? // Product/service code name (Arabic) — اسم الكود
  description String? // Line item description (English)
  descriptionAr String? // Line item description (Arabic) — الوصف

  // Financial
  subtotal  Float
  vatRate   Float  @default(14.00)
  vatAmount Float
  total     Float
  currency  String @default("EGP")

  returnedAmount       Float?    @default(0)
  retentionRate        Float?    @default(0)
  retentionAmount      Float?    @default(0)
  netPayable           Float?
  retentionReleaseDate DateTime?

  issueDate DateTime
  dueDate   DateTime?
  paidDate  DateTime?

  status        InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  consolidatedInvoiceId String?
  consolidatedInvoice   ConsolidatedInvoice? @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: SetNull)

  // ── Document processing (platform service, NOT financial spread) ──
  documentProcessing DocumentProcessing?

  // Factoring — operated by licensed third-party partner only
  // The platform does NOT hold cash or charge factoring fees
  factoringStatus      FactoringStatus    @default(NOT_FACTORABLE)
  factoringCompanyId   String?
  factoringCompany     FactoringCompany?  @relation(fields: [factoringCompanyId], references: [id])
  factoringRequests    FactoringRequest[]
  acceleratedCashRate  Decimal            @default(0) // Early payment discount rate applied
  supplierDiscountRate Decimal            @default(0) // Supplier's cash discount rate for early payment
  cashDiscountDelta    Decimal            @default(0) // Delta between supplier discount and factoring fee

  // Platform & admin fee fields
  platformFee         Decimal @default(0) // Platform fee charged per invoice
  platformFeeRate     Decimal @default(0) // Platform fee percentage rate
  hotelAdminFeeRate   Decimal @default(0) // Hotel admin fee percentage
  hotelAdminFeeAmount Decimal @default(0) // Calculated hotel admin fee amount

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  payments           Payment[]
  creditTransactions CreditTransaction[]
}

enum EtaStatus {
  PENDING
  SUBMITTING
  ACCEPTED
  REJECTED
  RETRYING
  MANUAL_RESOLUTION
}

model EtaCredential {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId     String
  clientSecret String // AES-256-GCM encrypted
  taxId        String
  environment  String    @default("preprod") // preprod | production
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SUBMITTED
  VALIDATED
  DISPUTED
  CREDIT_NOTE
}

enum PaymentStatus {
  PENDING
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  FACTORED // Paid by licensed factoring partner, not platform
}

enum FactoringStatus {
  NOT_FACTORABLE
  AVAILABLE
  OFFERED
  ACCEPTED
  PAID
  LOCKED_BY_MASTER
}

// ─────────────────────────────────────────
// 7. AUTHORITY MATRIX (Governance)
// ─────────────────────────────────────────

model AuthorityRule {
  id String @id @default(cuid())

  role         UserRole
  minValue     Float
  maxValue     Float
  category     String?
  supplierTier String?

  hotelRiskTier HotelRiskTier?
  hotelTier     HotelTier?

  requesterRole UserRole?

  requiresPaymentGuarantee Boolean @default(false)
  requiresEtaValidation    Boolean @default(false)
  requiresDualSignOff      Boolean @default(false)

  action AuthorityAction

  routeToRole UserRole?

  hotelId  String?
  tenantId String?

  name        String?
  description String?
  priority    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuthorityAction {
  AUTO_APPROVE
  ROUTE_TO_GM
  ROUTE_TO_FINANCIAL_CONTROLLER
  APPROVE
  DUAL_SIGN_OFF
  REJECT
  REQUIRE_OWNER
}

// ─────────────────────────────────────────
// 8. SPEND ANALYTICS
// ─────────────────────────────────────────

model SpendRecord {
  id    String @id @default(cuid())
  year  Int
  month Int

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category   ProductCategory
  amount     Float
  orderCount Int

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// 9. AUDIT LOG (Immutable)
// ─────────────────────────────────────────

model AuditLog {
  id String @id @default(cuid())

  entityType String
  entityId   String
  action     String

  actorId   String?
  actorRole String?

  beforeState String?
  afterState  String?

  ipAddress String?
  userAgent String?

  previousHash String?
  hash         String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// 10. FACTORING — Licensed Third-Party Partners Only
// ⚠️  The platform does NOT operate factoring. These models track
//     partner-operated factoring services for reference only.
// ─────────────────────────────────────────

model FactoringCompany {
  id           String                 @id @default(cuid())
  name         String
  legalName    String?
  taxId        String                 @unique
  contactEmail String?
  contactPhone String?
  status       FactoringCompanyStatus @default(ACTIVE)
  maxFacility  Float?

  invoices          Invoice[]
  creditTxns        CreditTransaction[]
  creditFacilities  CreditFacility[]
  factoringRequests FactoringRequest[]
  users             User[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditTransaction {
  id          String        @id @default(cuid())
  type        CreditTxnType
  amount      Float
  description String?

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  factoringCompanyId String?
  factoringCompany   FactoringCompany? @relation(fields: [factoringCompanyId], references: [id])

  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([hotelId])
  @@index([factoringCompanyId])
}

enum FactoringCompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CreditTxnType {
  CREDIT_DRAW
  CREDIT_REPAY
  FACTORING_ADVANCE
  FACTORING_COLLECTION
  ADJUSTMENT
}

model FactoringRequest {
  id String @id @default(cuid())

  consolidatedInvoiceId String?              @unique
  consolidatedInvoice   ConsolidatedInvoice? @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: Cascade)

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  requestedAmount Float
  requestedAt     DateTime @default(now())

  factoringCompanyId String
  factoringCompany   FactoringCompany @relation(fields: [factoringCompanyId], references: [id])

  status    FactoringRequestStatus @default(PENDING)
  riskScore Int?                   @default(50)
  riskTier  RiskTier               @default(MEDIUM)

  // Terms set by the factoring partner (not the platform)
  advanceRate        Float @default(0.90)
  discountRate       Float @default(0.02)
  membershipDiscount Float @default(0)

  grossAmount     Float?
  factoringFee    Float? // Charged by factoring partner, not platform
  disbursedAmount Float?
  platformFee     Float? @default(0) // Platform referral fee (invoiced off-chain)
  platformFeeRate Float? @default(0.005) // 0.5% default referral rate

  disbursedAt DateTime?
  settledAt   DateTime?
  hotelPaidAt DateTime?

  isNonRecourse   Boolean @default(true)
  partnerResponse String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
