// ─────────────────────────────────────────
// 11. INVO — Supplier SaaS Subscriptions & Document Processing
// ⚠️  SaaS marketplace model. NO cash custody, NO lending, NO factoring.
// ─────────────────────────────────────────

/// INVO subscription — Supplier pays flat monthly fee to be listed.
/// This is a SaaS/marketing subscription, NOT a financial product.
model InvoSubscription {
  id         String   @id @default(cuid())
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan   InvoPlan               @default(STARTER)
  status InvoSubscriptionStatus @default(ACTIVE)

  // Flat monthly SaaS fee
  monthlyFee    Float     @default(500)
  currency      String    @default("EGP")
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  cancelledAt   DateTime?
  lastBilledAt  DateTime?
  nextBillingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
}

/// Document processing — Tracks ETA invoice submissions per supplier.
/// Fee is charged per document processed (flat rate), NOT as % of invoice value.
/// This is a compliance document processing service, NOT factoring or lending.
model DocumentProcessing {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])

  // Link to the hotel invoice being processed
  hotelInvoiceId String?  @unique
  hotelInvoice   Invoice? @relation(fields: [hotelInvoiceId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Flat processing fee per document (NOT a financial spread)
  processingFee    Float               @default(5.00)
  documentsCount   Int                 @default(1)
  totalFee         Float               @default(5.00)
  currency         String              @default("EGP")
  status           DocProcessingStatus @default(PENDING)
  processedAt      DateTime?
  etaSubmissionRef String? // ETA UUID after successful submission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
}

enum InvoPlan {
  STARTER
  GROWTH
  PROFESSIONAL
}

enum InvoSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum DocProcessingStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  PAID
}

