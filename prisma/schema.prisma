model RfqRequest {
  id                    String    @id @default(cuid())
  rfqNumber             String    @unique
  title                 String
  description           String?
  status                RfqStatus @default(DRAFT)

  hotelId               String
  hotel                 Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById           String

  responseDeadline      DateTime
  expectedDeliveryDate  DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  publishedAt           DateTime?
  closedAt              DateTime?

  items                 RfqItem[]
  responses             RfqResponse[]

  selectedResponseId    String?      @unique
  selectedResponse      RfqResponse? @relation("SelectedResponse", fields: [selectedResponseId], references: [id])
  selectionReason       String?

  autoConvertToPo       Boolean      @default(true)
  generatedOrderId      String?

  // V2.0 REFACTOR: Orders generated from this RFQ
  orders                Order[]      @relation("RfqOrder")

