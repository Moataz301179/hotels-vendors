// ═══════════════════════════════════════════════════════════════
// MASTER INVOICE (Unified Basket ID) — NEW MODEL
// ═══════════════════════════════════════════════════════════════

model MasterInvoice {
  id                    String                 @id @default(cuid())
  basketId              String                 @unique
  invoiceNumber         String?                @unique
  status                MasterInvoiceStatus    @default(DRAFT)
  hotelId               String
  hotel                 Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  selectedFunderId      String?
  selectedFunder        FactoringCompany?      @relation(fields: [selectedFunderId], references: [id])
  selectedFacilityType  PaymentFacilityType?
  subtotal              Decimal                @db.Decimal(12, 2)
  vatAmount             Decimal                @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  currency              String                 @default("EGP")
  platformFee           Decimal                @default(0) @db.Decimal(12, 2)
  netPayable            Decimal                @db.Decimal(12, 2)
  creditLineReservedAt  DateTime?
  approvedAt            DateTime?
  issuedAt              DateTime?              @default(now())
  dueDate               DateTime?
  paidDate              DateTime?
  factoringType         FactoringType?
  factorApprovedAt      DateTime?
  factorDisbursedAt     DateTime?
  fraRegistryToken      String?
  etaInvoiceHash        String?
  payoutBatchId         String?
  grnVerifiedAt         DateTime?
  disputeWindowClosesAt DateTime?
  orders                Order[]
  invoices              Invoice[]
  supplierDisbursements SupplierDisbursement[]
  factoringRequest      FactoringRequest?
  disputeTickets        DisputeTicket[]
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  deliveryZones         DeliveryZone[]
  products              Product[]
  supplierAudits        SupplierAudit[]
  splitTransactions     SplitTransaction[]

  @@index([hotelId, status])
  @@index([basketId])
  @@index([fraRegistryToken])
}

// ═══════════════════════════════════════════════════════════════
// HOTEL-SUPPLIER RELATION — NEW MODEL
// ═══════════════════════════════════════════════════════════════

model HotelSupplier {
  id             String              @id @default(cuid())
  hotelId        String
  hotel          Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  commissionRate Decimal             @default(0.03) @db.Decimal(5, 4)
  settlementDays Int                 @default(15)
  status         HotelSupplierStatus @default(ACTIVE)
  claimToken     String?             @unique
  invitedAt      DateTime?           @default(now())
  isPreferred    Boolean             @default(false)
  totalOrders    Int                 @default(0)
  totalSpend     Decimal             @default(0) @db.Decimal(12, 2)
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt

  @@unique([hotelId, supplierId])
  @@index([supplierId])
}

// ═══════════════════════════════════════════════════════════════
// SUPPLIER DISBURSEMENT — OBSERVATIONAL ONLY
// ═══════════════════════════════════════════════════════════════

model SupplierDisbursement {
  id                   String             @id @default(cuid())
  masterInvoiceId      String
  masterInvoice        MasterInvoice      @relation(fields: [masterInvoiceId], references: [id], onDelete: Cascade)
  orderId              String?
  order                Order?             @relation(fields: [orderId], references: [id])
  invoiceId            String?
  invoice              Invoice?           @relation(fields: [invoiceId], references: [id])
  supplierId           String
  disbursedAmount      Decimal            @db.Decimal(12, 2)
  netDisbursed         Decimal            @db.Decimal(12, 2)
  currency             String             @default("EGP")
  status               DisbursementStatus @default(PENDING)
  funderId             String?
  funderTransactionRef String?
  observedBySystemAt   DateTime?
  bankTransactionRef   String?
  bankName             String?
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt

  @@index([masterInvoiceId])
  @@index([supplierId, status])
  @@index([funderId])
}

// ═══════════════════════════════════════════════════════════════
// DISPUTE TICKET — PLATFORM LOGS, FUNDER RESOLVES
// ═══════════════════════════════════════════════════════════════

model DisputeTicket {
  id                  String        @id @default(cuid())
  masterInvoiceId     String
  masterInvoice       MasterInvoice @relation(fields: [masterInvoiceId], references: [id], onDelete: Cascade)
  raisedByHotelId     String?
  raisedBySupplierId  String?
  raisedByUserId      String?
  disputeType         String
  description         String
  evidenceUrls        String?
  status              String        @default("OPEN")
  resolution          String?
  resolvedByFunderId  String?
  resolvedAt          DateTime?
  funderResolutionRef String?
  adjustmentAmount    Decimal?      @default(0) @db.Decimal(12, 2)
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  @@index([masterInvoiceId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// PAYMENT TRANSACTION — OBSERVATIONAL LEDGER
