generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ComplianceStatus {
  PENDING_TAX_VERIFICATION
  UNDER_REVIEW
  ACTIVE
  BLOCKED
  EXPIRED
}

enum MasterInvoiceStatus {
  DRAFT
  CREDIT_LINE_RESERVED
  PENDING_APPROVAL
  APPROVED
  ISSUED
  FACTORING_REQUESTED
  FACTOR_APPROVED
  FACTOR_DISBURSED
  PARTIALLY_PAID
  PAID
  DISPUTED
  CANCELLED
}

enum DisbursementStatus {
  PENDING
  OBSERVED_INITIATED
  CONFIRMED_BY_FUNDER
  SETTLED
  FAILED
  CANCELLED
}

enum HotelSupplierStatus {
  ACTIVE
  SUSPENDED
  PENDING_CLAIM
  EXPIRED
}

enum RecourseStatus {
  ACTIVE
  RECOVERY_IN_PROGRESS
  RECOVERED
  WRITTEN_OFF
}

enum PaymentFacilityType {
  REVERSE_FACTORING
  CONFIRMED_PAYABLE
  DYNAMIC_DISCOUNTING
  SUPPLY_CHAIN_FINANCE
}

enum FunderType {
  BANK
  NBFC
  FACTOR
  SUPPLY_CHAIN_FINANCE_PROVIDER
}

enum SettlementMethod {
  BANK_TRANSFER
  PAYMOB_B2B
  INSTAPAY
  CHEQUE
  UNDETERMINED
}

enum TransactionType {
  FUNDER_DISBURSEMENT
  HOTEL_PAYMENT
  SUPPLIER_PAYMENT
  PLATFORM_FEE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  INITIATED
  CONFIRMED
  FAILED
  REVERSED
}

enum TenantPlan {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

model AgentRun {
  id          String         @id @default(cuid())
  taskType    String
  taskName    String
  prompt      String
  agentName   String
  status      AgentRunStatus @default(PENDING)
  output      String?
  findings    String?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  parentRunId String?
  childRunIds String?
  createdAt   DateTime       @default(now())
}

model AiUsage {
  id            String   @id @default(cuid())
  userId        String   @unique
  messagesToday Int      @default(0)
  tokensToday   Int      @default(0)
  messagesTotal Int      @default(0)
  tokensTotal   Int      @default(0)
  quotaResetAt  DateTime @default(now())
  plan          AiPlan   @default(FREE)
  updatedAt     DateTime @default(now()) @updatedAt
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  action       String
  actorId      String?
  actorRole    String?
  beforeState  String?
  afterState   String?
  ipAddress    String?
  userAgent    String?
  previousHash String?
  hash         String?
  tenantId     String
  createdAt    DateTime @default(now())
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model AuthorityRule {
  id                       String          @id @default(cuid())
  role                     UserRole
  minValue                 Decimal         @db.Decimal(12, 2)
  maxValue                 Decimal         @db.Decimal(12, 2)
  category                 String?
  supplierTier             String?
  hotelRiskTier            HotelRiskTier?
  hotelTier                HotelTier?
  requesterRole            UserRole?
  requiresPaymentGuarantee Boolean         @default(false)
  requiresEtaValidation    Boolean         @default(false)
  requiresDualSignOff      Boolean         @default(false)
  action                   AuthorityAction
  routeToRole              UserRole?
  hotelId                  String?
  tenantId                 String?
  name                     String?
  fraRegistryToken         String?
  payoutBatchId            String?
  description              String?
  priority                 Int             @default(0)
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @default(now()) @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  hotelId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  tenantId  String
  Hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User      User       @relation(fields: [userId], references: [id])
  CartItem  CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  notes     String?
  Cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  model          String?
  tokensUsed     Int?
  latencyMs      Int?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CompassReading {
  id                    String   @id @default(cuid())
  date                  DateTime @unique @default(now())
  marketDirection       String   @default("STABLE")
  confidence            Int      @default(60)
  priceVelocity         String?
  paymentDynamics       String?
  macroIndicators       String?
  platformMetrics       String?
  alerts                String?
  pricingAdjustments    String?
  creditRecommendations String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt
}

model Competitor {
  id            String           @id @default(cuid())
  name          String           @unique
  legalName     String?
  website       String?
  logoUrl       String?
  type          CompetitorType
  marketFocus   String
  vertical      String
  model         String
  pricing       String?
  feeStructure  String?
  merchantCount Int?
  supplierCount Int?
  geoCoverage   String?
  features      String?
  strengths     String?
  weaknesses    String?
  funding       String?
  totalRaised   String?
  status        CompetitorStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  MarketInsight MarketInsight[]
}

model ConsolidatedOrder {
  id           String       @id @default(cuid())
  hubId        String
  tripId       String?
  status       String       @default("PENDING")
  totalValue   Float        @default(0)
  deliveryDate DateTime?
  tenantId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  LogisticsHub LogisticsHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
  Tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Trip         Trip?        @relation(fields: [tripId], references: [id])
}

model Conversation {
  id          String        @id @default(cuid())
  userId      String
  tenantId    String
  role        String
  title       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  ChatMessage ChatMessage[]
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId, updatedAt])
}

model CreditFacility {
  id                 String               @id @default(cuid())
  hotelId            String
  factoringCompanyId String
  limit              Decimal              @db.Decimal(12, 2)
  utilized           Decimal              @default(0) @db.Decimal(12, 2)
  interestRate       Decimal              @db.Decimal(5, 4)
  facilityType       PaymentFacilityType?
  status             CreditFacilityStatus @default(PENDING)
  approvedAt         DateTime?
  expiresAt          DateTime?
  tenantId           String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  FactoringCompany   FactoringCompany     @relation(fields: [factoringCompanyId], references: [id], onDelete: Cascade)
  Hotel              Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CreditLineApplication {
  id                   String    @id @default(cuid())
  status               String    @default("PENDING_REVIEW")
  hotelName            String
  brand                String?
  properties           Int?
  rooms                Int?
  governorate          String?
  address              String?
  crNumber             String
  taxId                String
  tourismLicense       String?
  gmName               String?
  gmPhone              String?
  gmEmail              String?
  cfoName              String?
  cfoPhone             String?
  annualRevenue        Decimal?  @db.Decimal(12, 2)
  netProfit            Decimal?  @db.Decimal(12, 2)
  totalAssets          Decimal?  @db.Decimal(12, 2)
  currentAssets        Decimal?  @db.Decimal(12, 2)
  totalLiabilities     Decimal?  @db.Decimal(12, 2)
  currentLiabilities   Decimal?  @db.Decimal(12, 2)
  bankBalance          Decimal?  @db.Decimal(12, 2)
  monthlyPurchases     Decimal?  @db.Decimal(12, 2)
  avgPaymentDays       Decimal?  @db.Decimal(12, 2)
  existingDebt         Decimal?  @db.Decimal(12, 2)
  propertyDeed         Boolean   @default(false)
  bankGuarantee        Boolean   @default(false)
  personalGuarantee    Boolean   @default(false)
  equipmentCollateral  Boolean   @default(false)
  depositAmount        Decimal?  @db.Decimal(12, 2)
  creditScore          Int?
  recommendedLimit     Decimal?  @db.Decimal(12, 2)
  aiAnalysisReport     String?
  aiRiskFlags          String?
  factoringCompanyId   String?
  approvedLimit        Decimal?  @db.Decimal(12, 2)
  approvedInterestRate Decimal?  @db.Decimal(5, 4)
  approvedAt           DateTime?
  rejectedReason       String?
  documents            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
}

model CreditTransaction {
  id                 String            @id @default(cuid())
  type               CreditTxnType
  amount             Decimal           @db.Decimal(12, 2)
  fraRegistryToken   String?
  payoutBatchId      String?
  description        String?
  hotelId            String
  factoringCompanyId String?
  orderId            String?
  invoiceId          String?
  tenantId           String
  createdAt          DateTime          @default(now())
  FactoringCompany   FactoringCompany? @relation(fields: [factoringCompanyId], references: [id])
  Hotel              Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  Order              Order?            @relation(fields: [orderId], references: [id])
  Tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([factoringCompanyId])
  @@index([hotelId])
}

model DeliveryZone {
  id              String         @id @default(cuid())
  zone            String
  minDays         Int
  maxDays         Int
  fee             Float
  masterInvoiceId String?
  masterInvoice   MasterInvoice? @relation(fields: [masterInvoiceId], references: [id], onDelete: SetNull)
  supplierId      String
  tenantId        String
  createdAt       DateTime       @default(now())
  Supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  Tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Document {
  id         String      @id @default(cuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  entityType String
  entityId   String
  category   DocCategory @default(OTHER)
  uploadedBy String
  tenantId   String
  createdAt  DateTime    @default(now())
  Tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([tenantId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FactoringCompany {
  id                  String                 @id @default(cuid())
  name                String
  legalName           String?
  taxId               String                 @unique
  contactEmail        String?
  contactPhone        String?
  funderType          FunderType?
  integrationEndpoint String?
  status              FactoringCompanyStatus @default(ACTIVE)
  maxFacility         Decimal?               @db.Decimal(12, 2)
  interestRate        Decimal?               @db.Decimal(5, 4)
  rate                Decimal?               @db.Decimal(5, 4)
  tenantId            String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now()) @updatedAt
  CreditFacility      CreditFacility[]
  CreditTransaction   CreditTransaction[]
  Tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  FactoringRequest    FactoringRequest[]
  Invoice             Invoice[]
  User                User[]
  masterInvoices      MasterInvoice[]
  digitalAgreements   DigitalAgreement[]
  ApiKey              ApiKey[]
}

model FactoringRequest {
  id                 String                 @id @default(cuid())
  invoiceId          String                 @unique
  requestedAmount    Decimal                @db.Decimal(12, 2)
  requestedAt        DateTime               @default(now())
  factoringCompanyId String
  facilityType       PaymentFacilityType?
  masterInvoiceId    String?                @unique
  masterInvoice      MasterInvoice?         @relation(fields: [masterInvoiceId], references: [id])
  fraRegistryToken   String?
  payoutBatchId      String?
  status             FactoringRequestStatus @default(PENDING)
  riskScore          Int?                   @default(50)
  riskTier           RiskTier               @default(MEDIUM)
  advanceRate        Decimal                @default(0.90) @db.Decimal(5, 4)
  discountRate       Decimal                @default(0.02) @db.Decimal(5, 4)
  platformFeeRate    Decimal                @default(0.015) @db.Decimal(5, 4)
  membershipDiscount Decimal                @default(0) @db.Decimal(5, 4)
  grossAmount        Decimal?               @db.Decimal(12, 2)
  platformFee        Decimal?               @db.Decimal(12, 2)
  netPlatformFee     Decimal?               @db.Decimal(12, 2)
  factoringFee       Decimal?               @db.Decimal(12, 2)
  disbursedAmount    Decimal?               @db.Decimal(12, 2)
  disbursedAt        DateTime?
  settledAt          DateTime?
  hotelPaidAt        DateTime?
  isNonRecourse      Boolean                @default(true)
  partnerResponse    String?
  tenantId           String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt
  FactoringCompany   FactoringCompany       @relation(fields: [factoringCompanyId], references: [id])
  Invoice            Invoice                @relation(fields: [invoiceId], references: [id])
  Tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recourseLiability  RecourseLiability?
}

model FeatureProposal {
  id                   String          @id @default(cuid())
  title                String
  description          String
  category             FeatureCategory
  targetActor          String
  problem              String
  solution             String
  complexity           Complexity      @default(MEDIUM)
  impact               Impact          @default(MEDIUM)
  effortWeeks          Float?
  gapAddressed         String?
  moatScore            Int             @default(50)
  revenuePotential     String?
  status               ProposalStatus  @default(PROPOSED)
  proposedBy           String
  votes                Int             @default(0)
  relatedCompetitorIds String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
}

model Hotel {
  id                   String               @id @default(cuid())
  tenantId             String
  name                 String
  legalName            String?
  legalNameAr          String?
  taxId                String               @unique
  commercialReg        String?
  address              String?
  city                 String
  governorate          String
  phone                String?
  email                String?
  starRating           Int?
  roomCount            Int?
  tier                 HotelTier            @default(CORE)
  status               HotelStatus          @default(ACTIVE)
  creditLimit          Decimal?             @db.Decimal(12, 2)
  creditUsed           Decimal?             @default(0) @db.Decimal(12, 2)
  riskScore            Int?                 @default(50)
  riskTier             RiskTier?            @default(MEDIUM)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  Cart                 Cart[]
  CreditFacility       CreditFacility[]
  CreditTransaction    CreditTransaction[]
  Tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Invoice              Invoice[]
  JournalEntry         JournalEntry[]
  Order                Order[]
  Payment              Payment[]
  Property             Property[]
  SpendRecord          SpendRecord[]
  TripStop             TripStop[]
  User                 User[]
  masterInvoices       MasterInvoice[]
  hotelSuppliers       HotelSupplier[]
  procurementBudgets   ProcurementBudget[]
  occupancyTelemetries OccupancyTelemetry[]
  recourseLiabilities  RecourseLiability[]
  splitTransactions    SplitTransaction[]
  loyaltyAccount       LoyaltyAccount?
  creditLine           HotelCreditLine?
  digitalAgreements    DigitalAgreement[]
}

model InventorySnapshot {
  id              String   @id @default(cuid())
  productId       String
  tenantId        String
  stockLevel      Int
  projectedDays   Float
  aiSuggestion    String?
  occupancyRate   Float?
  consumptionRate Float?
  createdAt       DateTime @default(now())
  Product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  Tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                    String                 @id @default(cuid())
  invoiceNumber         String                 @unique
  etaUuid               String?                @unique
  etaStatus             EtaStatus              @default(PENDING)
  digitalSignature      String?
  submissionLog         String?
  subtotal              Decimal                @db.Decimal(12, 2)
  vatRate               Decimal                @default(14.00) @db.Decimal(5, 2)
  vatAmount             Decimal                @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  currency              String                 @default("EGP")
  issueDate             DateTime
  dueDate               DateTime?
  paidDate              DateTime?
  etaInvoiceHash        String?
  masterFactoringStatus String?                @default("NOT_LOCKED")
  supplierDiscountRate  Decimal?               @default(0.03) @db.Decimal(5, 4)
  acceleratedCashRate   Decimal?               @db.Decimal(5, 4)
  cashDiscountDelta     Decimal?               @db.Decimal(12, 2)
  status                InvoiceStatus          @default(DRAFT)
  paymentStatus         PaymentStatus          @default(UNPAID)
  orderId               String
  hotelId               String
  masterInvoiceId       String?
  masterInvoice         MasterInvoice?         @relation(fields: [masterInvoiceId], references: [id], onDelete: SetNull)
  supplierId            String
  tenantId              String
  factoringStatus       FactoringStatus        @default(NOT_FACTORABLE)
  factoringCompanyId    String?
  factoringAmount       Decimal?               @db.Decimal(12, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  CreditTransaction     CreditTransaction[]
  FactoringRequest      FactoringRequest?
  FactoringCompany      FactoringCompany?      @relation(fields: [factoringCompanyId], references: [id])
  Hotel                 Hotel                  @relation(fields: [hotelId], references: [id])
  Order                 Order                  @relation(fields: [orderId], references: [id])
  Supplier              Supplier               @relation(fields: [supplierId], references: [id])
  Tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Payment               Payment[]
  supplierDisbursements SupplierDisbursement[]
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String        @unique
  date        DateTime
  sourceType  String
  sourceId    String
  description String
  lines       String
  totalDebit  Decimal       @db.Decimal(12, 2)
  totalCredit Decimal       @db.Decimal(12, 2)
  status      JournalStatus @default(POSTED)
  hotelId     String?
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  Hotel       Hotel?        @relation(fields: [hotelId], references: [id])
  Tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Lead {
  id            String        @id @default(cuid())
  entityType    LeadType
  name          String
  legalName     String?
  website       String?
  email         String?
  phone         String?
  city          String?
  governorate   String?
  address       String?
  tier          LeadTier      @default(UNRATED)
  starRating    Int?
  roomCount     Int?
  category      String?
  source        String
  sourceUrl     String?
  discoveredBy  String
  enrichment    String?
  trustSignals  String?
  status        LeadStatus    @default(DISCOVERED)
  priority      Int           @default(5)
  lastContactAt DateTime?
  contactCount  Int           @default(0)
  responseCount Int           @default(0)
  convertedAt   DateTime?
  convertedToId String?
  tenantId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  OutreachLog   OutreachLog[]

  @@index([city, entityType])
  @@index([priority, status])
  @@index([status, entityType])
  @@index([tenantId])
}

model LogisticsHub {
  id                String              @id @default(cuid())
  name              String
  code              String?
  city              String
  governorate       String
  address           String?
  lat               Decimal?            @db.Decimal(10, 8)
  lng               Decimal?            @db.Decimal(11, 8)
  type              HubType             @default(CONSOLIDATION)
  operatingHours    String?
  contactPhone      String?
  isActive          Boolean             @default(true)
  tenantId          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  ConsolidatedOrder ConsolidatedOrder[]
  Tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Trip              Trip[]
}

model MarketInsight {
  id           String          @id @default(cuid())
  title        String
  category     InsightCategory
  summary      String
  detail       String?
  sourceUrl    String?
  sourceName   String?
  publishedAt  DateTime?
  confidence   Int             @default(80)
  impactScore  Int             @default(50)
  competitorId String?
  discoveredBy String
  verified     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  Competitor   Competitor?     @relation(fields: [competitorId], references: [id])
}

model ModelHealth {
  id            String      @id @default(cuid())
  provider      String
  model         String
  status        ModelStatus @default(HEALTHY)
  failCount     Int         @default(0)
  lastFailureAt DateTime?
  lastSuccessAt DateTime?
  avgLatencyMs  Float?
  totalCalls    Int         @default(0)
  successRate   Float       @default(1.0)
  isPrimary     Boolean     @default(false)
  isFallback    Boolean     @default(false)
  updatedAt     DateTime    @default(now()) @updatedAt

  @@unique([provider, model])
}

model Order {
  id                     String                 @id @default(cuid())
  orderNumber            String                 @unique
  status                 OrderStatus            @default(DRAFT)
  subtotal               Decimal                @db.Decimal(12, 2)
  vatAmount              Decimal                @db.Decimal(12, 2)
  total                  Decimal                @db.Decimal(12, 2)
  currency               String                 @default("EGP")
  deliveryDate           DateTime?
  deliveryInstructions   String?
  hotelId                String
  propertyId             String?
  outletId               String?
  masterInvoiceId        String?
  masterInvoice          MasterInvoice?         @relation(fields: [masterInvoiceId], references: [id], onDelete: SetNull)
  supplierId             String
  requesterId            String
  tenantId               String
  etaSubmissionId        String?
  paymentGuaranteed      Boolean                @default(false)
  paymentGuaranteeMethod String?
  paymentGuaranteeSetAt  DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  checkoutGroupId        String?
  costCenter             String?
  deliveryAddress        String?
  estimatedDelivery      DateTime?
  poNumber               String?
  shippingCost           Decimal?               @default(0) @db.Decimal(12, 2)
  shippingMethod         String?
  paymentLane            PaymentLane?           @default(DIRECT_BANK)
  paymentLaneRef         String?                // factoringRequestId or creditTermsRef
  CreditTransaction      CreditTransaction[]
  Invoice                Invoice[]
  Hotel                  Hotel                  @relation(fields: [hotelId], references: [id])
  Outlet                 Outlet?                @relation(fields: [outletId], references: [id])
  Property               Property?              @relation(fields: [propertyId], references: [id])
  User                   User                   @relation(fields: [requesterId], references: [id])
  Supplier               Supplier               @relation(fields: [supplierId], references: [id])
  Tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  OrderApproval          OrderApproval[]
  OrderItem              OrderItem[]
  TripStop               TripStop[]
