  rfq               RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  productCategory   ProductCategory
  productName       String
  description       String?
  quantity          Int
  unitOfMeasure     String     @default("kg")
  qualitySpecs      String?

  productId         String?
  product           Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  targetPrice       Decimal?
  currency          String     @default("EGP")

  responses         RfqItemResponse[]

  createdAt         DateTime   @default(now())
}

model RfqResponse {
  id              String             @id @default(cuid())
  rfqId           String
  rfq             RfqRequest         @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  status          RfqResponseStatus  @default(DRAFT)

  totalPrice      Decimal
  currency        String             @default("EGP")
  deliveryDays    Int
  shippingMethod  ShippingMethod     @default(SUPPLIER_SELF)
  notes           String?
  validUntil      DateTime

  items           RfqItemResponse[]

  selectedOrders  RfqRequest[]       @relation("SelectedResponse")
  rank            Int?

  submittedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([rfqId, supplierId])
  @@index([rfqId, status])
  @@index([supplierId])
}

model RfqItemResponse {
  id              String     @id @default(cuid())
  rfqResponseId   String
  rfqResponse     RfqResponse @relation(fields: [rfqResponseId], references: [id], onDelete: Cascade)
  rfqItemId       String
  rfqItem         RfqItem    @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

