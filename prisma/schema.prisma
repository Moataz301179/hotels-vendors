generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                   String                   @id @default(cuid())
  email                                String
  name                                 String
  companyName                          String?
  phone                                String?
  role                                 UserRole                 @default(DEPARTMENT_HEAD)
  status                               UserStatus               @default(ACTIVE)
  sector                               UserSector?
  passwordHash                         String?
  nationalId                           String?
  platformRole                         PlatformRole             @default(HOTEL)
  tenantId                             String
  roleId                               String
  hotelId                              String?
  supplierId                           String?
  factoringCompanyId                   String?
  canOverride                          Boolean                  @default(false)
  inviteToken                          String?                  @unique
  inviteExpiresAt                      DateTime?
  invitedBy                            String?
  createdAt                            DateTime                 @default(now())
  updatedAt                            DateTime                 @updatedAt
  lastActive                           DateTime?
  accountType                          AccountType              @default(BUSINESS)
  emailVerifiedAt                      DateTime?
  carrierId                            String?
  phoneVerifiedAt                      DateTime?
  AiUsage                              AiUsage?
  Cart                                 Cart?
  Conversation                         Conversation[]
  Grn_Grn_receivedByIdToUser           Grn[]                    @relation("Grn_receivedByIdToUser")
  Grn_Grn_signedByIdToUser             Grn[]                    @relation("Grn_signedByIdToUser")
  Invite_Invite_acceptedByUserIdToUser Invite[]                 @relation("Invite_acceptedByUserIdToUser")
  Invite_Invite_invitedByIdToUser      Invite[]                 @relation("Invite_invitedByIdToUser")
  Notification                         Notification[]
  NotificationPreference               NotificationPreference?
  Order_Order_confirmedByIdToUser      Order[]                  @relation("Order_confirmedByIdToUser")
  Order_Order_requesterIdToUser        Order[]                  @relation("Order_requesterIdToUser")
  OrderApproval                        OrderApproval[]
  PhoneVerificationToken               PhoneVerificationToken[]
  ProductReview                        ProductReview[]
  SampleRequest                        SampleRequest[]
  Carrier                              Carrier?                 @relation(fields: [carrierId], references: [id])
  FactoringCompany                     FactoringCompany?        @relation(fields: [factoringCompanyId], references: [id])
  Hotel                                Hotel?                   @relation(fields: [hotelId], references: [id])
  Role                                 Role                     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  Supplier                             Supplier?                @relation(fields: [supplierId], references: [id])
  Tenant                               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  UserAddress                          UserAddress[]

  @@unique([tenantId, email])
  @@index([sector])
}

model AgentRun {
  id          String         @id
  taskType    String
  taskName    String
  prompt      String
  agentName   String
  status      AgentRunStatus @default(PENDING)
  output      String?
  findings    String?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  parentRunId String?
  childRunIds String?
  tenantId    String
  createdAt   DateTime       @default(now())
  Tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, tenantId])
  @@index([tenantId])
}

model AiUsage {
  id                 String   @id
  userId             String   @unique
  tenantId           String
  messagesToday      Int      @default(0)
  tokensToday        Int      @default(0)
  messagesTotal      Int      @default(0)
  tokensTotal        Int      @default(0)
  quotaResetAt       DateTime @default(now())
  plan               AiPlan   @default(FREE)
  onboardingProgress String?
  updatedAt          DateTime
  Tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id                 String            @id
  keyHash            String            @unique
  keyPrefix          String
  name               String
  description        String?
  supplierId         String?
  tenantId           String
  scopes             String[]
  rateLimitPerMinute Int               @default(60)
  status             ApiKeyStatus      @default(ACTIVE)
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  Supplier           Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  Tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  WebhookEndpoint    WebhookEndpoint[]

  @@index([keyPrefix])
  @@index([supplierId])
  @@index([tenantId])
}

model AuditLog {
  id           String   @id
  entityType   String
  entityId     String
  action       String
  actorId      String?
  actorRole    String?
  beforeState  String?
  afterState   String?
  ipAddress    String?
  userAgent    String?
  previousHash String?
  hash         String?
  tenantId     String
  createdAt    DateTime @default(now())
  Tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model AuthorityRule {
  id                       String          @id
  role                     UserRole
  minValue                 Decimal
  maxValue                 Decimal
  category                 String?
  supplierTier             String?
  hotelRiskTier            HotelRiskTier?
  hotelTier                HotelTier?
  requesterRole            UserRole?
  requiresPaymentGuarantee Boolean         @default(false)
  requiresEtaValidation    Boolean         @default(false)
  requiresDualSignOff      Boolean         @default(false)
  action                   AuthorityAction
  routeToRole              UserRole?
  approvalChain            String?
  canRequestFactoring      Boolean         @default(false)
  hotelId                  String?
  tenantId                 String?
  name                     String?
  description              String?
  priority                 Int             @default(0)
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime
}

model AutoReorderRule {
  id              String    @id
  hotelId         String
  productId       String
  supplierId      String?
  minStock        Decimal
  reorderQuantity Decimal
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  Supplier        Supplier? @relation(fields: [supplierId], references: [id])
  Tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([hotelId, productId])
  @@index([isActive])
}

model Banner {
  id              String          @id
  title           String
  subtitle        String?
  imageUrl        String
  targetUrl       String
  placement       BannerPlacement
  startDate       DateTime
  endDate         DateTime
  maxImpressions  Int?
  impressionCount Int             @default(0)
  clickCount      Int             @default(0)
  isActive        Boolean         @default(true)
  targetAudience  BannerAudience  @default(ALL)
  tenantId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  Tenant          Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([placement, isActive])
  @@index([startDate, endDate])
}

model BlogPost {
  id          String   @id
  slug        String   @unique
  title       String
  titleAr     String?
  excerpt     String
  content     String
  coverImage  String?
  category    String   @default("insights")
  tags        String[] @default([])
  authorName  String   @default("HotelsVendors Team")
  authorTitle String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([category])
  @@index([published, publishedAt(sort: Desc)])
}

model Carrier {
  id               String        @id
  name             String
  legalName        String?
  taxId            String?       @unique
  commercialReg    String?
  contactEmail     String?
  contactPhone     String?
  contactPerson    String?
  fleetSize        Int?
  hasReefer        Boolean       @default(false)
  hasFrozen        Boolean       @default(false)
  hasChilled       Boolean       @default(false)
  coverageAreas    String?
  status           CarrierStatus @default(PENDING_VERIFICATION)
  reliabilityScore Float?        @default(0)
  rating           Float?        @default(0)
  bankAccount      String?
  bankName         String?
  paymentTerms     String        @default("NET_48")
  tenantId         String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  Tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  CarrierRate      CarrierRate[]
  DeliveryJob      DeliveryJob[]
  User             User[]

  @@index([status])
  @@index([tenantId])
}

model CarrierRate {
  id              String          @id
  carrierId       String
  fromGovernorate String
  toGovernorate   String
  fromCity        String?
  toCity          String?
  rateType        CarrierRateType @default(PER_KG)
  baseRate        Decimal
  minCharge       Decimal?
  fuelSurcharge   Decimal?        @default(0)
  currency        String          @default("EGP")
  minWeight       Decimal?
  maxWeight       Decimal?
  estimatedDays   Int?
  temperatureZone TemperatureZone @default(AMBIENT)
  validFrom       DateTime        @default(now())
  validUntil      DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  Carrier         Carrier         @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@index([carrierId, fromGovernorate, toGovernorate])
}

model Cart {
  id        String     @id
  userId    String     @unique
  hotelId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime
  tenantId  String
  Hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  User      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]
}

model CartItem {
  id        String   @id
  cartId    String
  productId String
  quantity  Int
  unitPrice Decimal
  total     Decimal
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CashFlowForecast {
  id               String   @id
  hotelId          String
  tenantId         String
  forecastDate     DateTime
  period           String
  expectedOutflows Decimal
  expectedInflows  Decimal
  netPosition      Decimal
  recommendations  String?
  actualOutflows   Decimal?
  accuracyScore    Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  Hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([hotelId, period])
}

model ChatMessage {
  id             String       @id
  conversationId String
  role           String
  content        String
  model          String?
  tokensUsed     Int?
  latencyMs      Int?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CompassReading {
  id                    String   @id
  date                  DateTime @unique @default(now())
  marketDirection       String   @default("STABLE")
  confidence            Int      @default(60)
  priceVelocity         String?
  paymentDynamics       String?
  macroIndicators       String?
  platformMetrics       String?
  alerts                String?
  pricingAdjustments    String?
  creditRecommendations String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime
}

model Competitor {
  id            String           @id
  name          String           @unique
  legalName     String?
  website       String?
  logoUrl       String?
  type          CompetitorType
  marketFocus   String
  vertical      String
  model         String
  pricing       String?
  feeStructure  String?
  merchantCount Int?
  supplierCount Int?
  geoCoverage   String?
  features      String?
  strengths     String?
  weaknesses    String?
  funding       String?
  totalRaised   String?
  status        CompetitorStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime
  MarketInsight MarketInsight[]
}

model ConnectorLog {
  id               String      @id
  integrationId    String
  syncType         String
  direction        String
  status           String
  recordsProcessed Int?
  recordsFailed    Int?
  errorMessage     String?
  details          String?
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  Integration      Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
}

model ConsolidatedInvoice {
  id                  String             @id
  invoiceNumber       String             @unique
  status              ConsolidatedStatus @default(DRAFT)
  subtotal            Decimal
  vatAmount           Decimal
  total               Decimal
  currency            String             @default("EGP")
  issueDate           DateTime           @default(now())
  dueDate             DateTime
  paidDate            DateTime?
  hotelId             String
  tenantId            String
  hotelAdminFeeAmount Decimal?           @default(0)
  hotelAdminFeeRate   Decimal?           @default(0.01)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime
  Hotel               Hotel              @relation(fields: [hotelId], references: [id])
  Tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  FactoringRequest    FactoringRequest?
  Invoice             Invoice[]
}

model ConsolidatedOrder {
  id           String       @id
  hubId        String
  tripId       String?
  status       String       @default("PENDING")
  totalValue   Decimal      @default(0)
  deliveryDate DateTime?
  tenantId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  LogisticsHub LogisticsHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
  Tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Trip         Trip?        @relation(fields: [tripId], references: [id])
}

model Conversation {
  id          String        @id
  userId      String
  tenantId    String
  role        String
  title       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  ChatMessage ChatMessage[]
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId, updatedAt])
}

model CreditFacility {
  id                 String               @id
  hotelId            String
  factoringCompanyId String
  limit              Decimal
  utilized           Decimal              @default(0)
  interestRate       Decimal
  status             CreditFacilityStatus @default(PENDING)
  approvedAt         DateTime?
  expiresAt          DateTime?
  tenantId           String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  FactoringCompany   FactoringCompany     @relation(fields: [factoringCompanyId], references: [id], onDelete: Cascade)
  Hotel              Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CreditLineApplication {
  id                   String    @id
  status               String    @default("PENDING_REVIEW")
  hotelName            String
  brand                String?
  properties           Int?
  rooms                Int?
  governorate          String?
  address              String?
  crNumber             String
  taxId                String
  tourismLicense       String?
  gmName               String?
  gmPhone              String?
  gmEmail              String?
  cfoName              String?
  cfoPhone             String?
  annualRevenue        Decimal?
  netProfit            Decimal?
  totalAssets          Decimal?
  currentAssets        Decimal?
  totalLiabilities     Decimal?
  currentLiabilities   Decimal?
  bankBalance          Decimal?
  monthlyPurchases     Decimal?
  avgPaymentDays       Decimal?
  existingDebt         Decimal?
  propertyDeed         Boolean   @default(false)
  bankGuarantee        Boolean   @default(false)
  personalGuarantee    Boolean   @default(false)
  equipmentCollateral  Boolean   @default(false)
  depositAmount        Decimal?
  creditScore          Int?
  recommendedLimit     Decimal?
  aiAnalysisReport     String?
  aiRiskFlags          String?
  factoringCompanyId   String?
  approvedLimit        Decimal?
  approvedInterestRate Decimal?
  approvedAt           DateTime?
  rejectedReason       String?
  documents            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
}

model CreditNote {
  id                 String           @id
  creditNoteNumber   String           @unique
  invoiceId          String
  supplierId         String
  hotelId            String
  tenantId           String
  status             CreditNoteStatus @default(ISSUED)
  subtotal           Decimal
  vatAmount          Decimal
  total              Decimal
  currency           String           @default("EGP")
  appliedToInvoiceId String?
  refundedAmount     Decimal?
  issuedAt           DateTime         @default(now())
  appliedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  Hotel              Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Invoice            Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Supplier           Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  Tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ReturnRequest      ReturnRequest?

  @@index([hotelId])
  @@index([invoiceId])
  @@index([supplierId])
}

model CreditTransaction {
  id                 String            @id
  type               CreditTxnType
  amount             Decimal
  description        String?
  hotelId            String
  factoringCompanyId String?
  orderId            String?
  invoiceId          String?
  tenantId           String
  createdAt          DateTime          @default(now())
  FactoringCompany   FactoringCompany? @relation(fields: [factoringCompanyId], references: [id])
  Hotel              Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  Order              Order?            @relation(fields: [orderId], references: [id])
  Tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([factoringCompanyId])
  @@index([hotelId])
}

model DeliveryJob {
  id              String            @id
  jobNumber       String            @unique
  carrierId       String
  orderId         String
  tripId          String?
  tripStopId      String?
  pickupAddress   String
  pickupContact   String?
  pickupPhone     String?
  pickupDate      DateTime?
  pickedUpAt      DateTime?
  deliveryAddress String
  deliveryContact String?
  deliveryPhone   String?
  deliveryDate    DateTime?
  deliveredAt     DateTime?
  status          DeliveryJobStatus @default(ASSIGNED)
  shippingCost    Decimal
  platformFee     Decimal           @default(0)
  carrierPayout   Decimal           @default(0)
  currency        String            @default("EGP")
  paidToCarrier   Boolean           @default(false)
  carrierPaidAt   DateTime?
  podPhotoUrl     String?
  signatureUrl    String?
  otpDeliveryId   String?           @unique
  temperatureLog  String?
  tempViolation   Boolean           @default(false)
  tenantId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Carrier         Carrier           @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  Order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  OtpDelivery     OtpDelivery?      @relation(fields: [otpDeliveryId], references: [id])
  Tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Trip            Trip?             @relation(fields: [tripId], references: [id])
  TripStop        TripStop?         @relation(fields: [tripStopId], references: [id])

  @@index([carrierId, status])
  @@index([orderId])
  @@index([status, deliveryDate])
}

model DeliveryZone {
  id         String   @id
  zone       String
  minDays    Int
  maxDays    Int
  fee        Decimal
  supplierId String
  tenantId   String
  createdAt  DateTime @default(now())
  Supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DemandForecast {
  id                String   @id
  hotelId           String
  productId         String
  forecastDate      DateTime
  predictedQuantity Decimal
  confidence        Decimal
  modelVersion      String
  actualQuantity    Decimal?
  accuracyScore     Decimal?
  tenantId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  Hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  Product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  Tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([hotelId, forecastDate])
  @@index([productId])
}

model Dispute {
  id             String               @id
  disputeNumber  String               @unique
  orderId        String
  reason         String
  evidenceUrls   String?
  amountDisputed Decimal
  status         DisputeStatus        @default(OPEN)
  resolution     String?
  liability      LiabilityAssignment?
  tenantId       String
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  Order          Order                @relation(fields: [orderId], references: [id])
  Tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Document {
  id         String      @id
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  entityType String
  entityId   String
  category   DocCategory @default(OTHER)
  uploadedBy String
  tenantId   String
  createdAt  DateTime    @default(now())
  Tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([tenantId])
}

model DocumentProcessing {
  id               String              @id
  invoiceNumber    String              @unique
  supplierId       String
  hotelInvoiceId   String?             @unique
  tenantId         String
  processingFee    Decimal             @default(5.00)
  documentsCount   Int                 @default(1)
  totalFee         Decimal             @default(5.00)
  currency         String              @default("EGP")
  status           DocProcessingStatus @default(PENDING)
  processedAt      DateTime?
  etaSubmissionRef String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
  Invoice          Invoice?            @relation(fields: [hotelInvoiceId], references: [id])
  Supplier         Supplier            @relation(fields: [supplierId], references: [id])
  Tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([supplierId])
}

model DynamicDiscountOffer {
  id              String              @id
  invoiceId       String
  supplierId      String
  originalDueDate DateTime
  earlyPayDate    DateTime
  discountPercent Decimal
  discountAmount  Decimal
  earlyPayAmount  Decimal
  status          DiscountOfferStatus @default(PENDING)
  acceptedAt      DateTime?
  paidAt          DateTime?
  tenantId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime
  Invoice         Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  Tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
}

model EmailVerificationToken {
  id        String   @id
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EtaCredential {
  id           String    @id
  tenantId     String    @unique
  clientId     String
  clientSecret String
  taxId        String
  environment  String    @default("preprod")
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FactoringCompany {
  id                    String                 @id
  name                  String
  legalName             String?
  taxId                 String                 @unique
  contactEmail          String?
  contactPhone          String?
  status                FactoringCompanyStatus @default(ACTIVE)
  maxFacility           Decimal?
  interestRate          Decimal?
  feeRate               Decimal?
  licenseNumber         String?
  licenseVerified       Boolean                @default(false)
  licenseVerifiedAt     DateTime?
  licenseVerifiedBy     String?
  cbeRegistrationNumber String?
  fraLicenseId          String?
  riskRating            String?
  bankName              String?
  bankAccount           String?
  paymobMerchantId      String?
  tenantId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  CreditFacility        CreditFacility[]
  CreditTransaction     CreditTransaction[]
  Tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  FactoringRequest      FactoringRequest[]
  Invoice               Invoice[]
  User                  User[]
}

model FactoringRequest {
  id                    String                 @id
  consolidatedInvoiceId String?                @unique
  invoiceId             String?                @unique
