  @@index([type])
}

enum SplitStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum SplitItemStatus {
  PENDING
  HELD_IN_RESERVE
  PROCESSING
  PAID
  FAILED
  REVERSED
}

enum RecipientType {
  SUPPLIER
  PLATFORM
  FACTORING
  LOGISTICS
}

enum FeeType {
  PERCENTAGE
  FLAT
  TIERED
}

// ═══════════════════════════════════════════════════════════════
// HOTEL CREDIT LINE — Pre-approved financing facility
// ═══════════════════════════════════════════════════════════════

model HotelCreditLine {
  id                String          @id @default(cuid())
  hotelId           String          @unique
  Hotel             Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  nbfiPartnerId     String          // FactoringCompany or external NBFI
  approvedLimit     Decimal         @db.Decimal(12, 2)
  availableBalance  Decimal         @db.Decimal(12, 2)
  utilizedBalance   Decimal         @default(0) @db.Decimal(12, 2)
  interestRate      Decimal         @db.Decimal(5, 4)    // APR e.g. 0.16 = 16%
  tenorDays         Int             @default(60)
  status            CreditLineStatus @default(PENDING)
  approvedAt        DateTime?
  expiresAt         DateTime?
  autoRenew         Boolean         @default(false)
  tenantId          String
  Tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draws             CreditDraw[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
}

model CreditDraw {
  id              String          @id @default(cuid())
  creditLineId    String
  creditLine      HotelCreditLine @relation(fields: [creditLineId], references: [id], onDelete: Cascade)
  masterInvoiceId String?
  amount          Decimal         @db.Decimal(12, 2)
  interestAmount  Decimal         @db.Decimal(12, 2)
  totalDue        Decimal         @db.Decimal(12, 2)
  dueDate         DateTime
  repaidAmount    Decimal         @default(0) @db.Decimal(12, 2)
  status          DrawStatus      @default(DRAWN)
  repayments      CreditRepayment[]
  tenantId        String
  Tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
}

model CreditRepayment {
  id          String          @id @default(cuid())
  creditDrawId String
  creditDraw  CreditDraw      @relation(fields: [creditDrawId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(12, 2)
  type        RepaymentType   @default(SCHEDULED)
  penaltyAmount Decimal       @default(0) @db.Decimal(12, 2)
  tenantId    String
  Tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
}

enum CreditLineStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CLOSED
}

enum DrawStatus {
  DRAWN
  PARTIALLY_REPAID
  REPAID
  DEFAULTED
}

enum RepaymentType {
  SCHEDULED
  EARLY
  PARTIAL
  AUTO_DEBIT
}

// ═══════════════════════════════════════════════════════════════
// DIGITAL AGREEMENTS — Automated contract execution
// ═══════════════════════════════════════════════════════════════

model AgreementTemplate {
  id            String   @id @default(cuid())
  slug          String   @unique   // agency_factoring, supplier_ack, hotel_disclosure, financing_terms
  name          String
  description   String?
  content       String   // HTML template with {{variables}}
  requiredRoles String   // comma-separated: HOTEL_OWNER, SUPPLIER_OWNER, NBFI_REP
  version       Int      @default(1)
  active        Boolean  @default(true)
  tenantId      String
  Tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreements    DigitalAgreement[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model DigitalAgreement {
  id              String            @id @default(cuid())
  templateId      String
  template        AgreementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  // Parties
  hotelId         String?
  Hotel           Hotel?            @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  supplierId      String?
  Supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  factoringCompanyId String?
  FactoringCompany FactoringCompany? @relation(fields: [factoringCompanyId], references: [id], onDelete: SetNull)
  
  // Content
  renderedContent String            // Final HTML after variable substitution
  variables       String?           // JSON of substituted values
  
  // Signatures
  status          AgreementStatus   @default(DRAFT)
  signedByHotelAt DateTime?
  signedBySupplierAt DateTime?
  signedByNbfiAt  DateTime?
  hotelSignature  String?           // e-Seal hash or digital sig
  supplierSignature String?
  nbfiSignature   String?
  
  // Document
  documentUrl     String?           // PDF storage path
  etaDocumentUuid String?           // If registered with ETA
  
  tenantId        String
  Tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

enum AgreementStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  SIGNED
  EXPIRED
  VOIDED
}

enum ScoreSource {
  I_SCORE
  DUN_BRADSTREET
  GAFI
  MANUAL
  PLATFORM_INTERNAL
}

enum CertificateType {
  E_SEAL
  E_SIGNATURE
  HSM
}

enum CertificateStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING_UPLOAD
}
