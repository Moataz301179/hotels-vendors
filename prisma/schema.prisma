// Hotels Vendors — Digital Procurement Marketplace + Compliance Automation
// PostgreSQL + Multi-tenant schema
// Last updated: 2026-06-07
//
// ⚠️  LEGAL CONSTRAINT: This platform does NOT hold or transfer cash.
// The platform operator holds a DIGITAL MARKETING license only.
// All financial services (factoring, credit, payments) are operated by
// licensed third-party partners. The platform only charges:
//   1. SaaS subscription fees (supplier listing plans via INVO)
//   2. Document processing fees (ETA invoice submission per-document)
//   3. Marketplace commission on transactions (not financial spreads)
// No factoring fees, no cash custody, no lending, no wallet balances.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// TENANT — Multi-tenant isolation root
// ─────────────────────────────────────────

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  type         TenantType   @default(HOTEL_GROUP)
  status       TenantStatus @default(ACTIVE)
  taxId        String?      @unique
  logoUrl      String?
  primaryColor String?

  // Relations
  users          User[]
  hotels         Hotel[]
  suppliers      Supplier[]
  products       Product[]
  orders         Order[]
  invoices       Invoice[]
  auditLogs      AuditLog[]
  documents      Document[]
  carts          Cart[]
  journalEntries JournalEntry[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  roles                Role[]
  properties           Property[]
  deliveryZones        DeliveryZone[]
  spendRecords         SpendRecord[]
  inventorySnapshots   InventorySnapshot[]
  factoringCompanies   FactoringCompany[]
  creditTransactions   CreditTransaction[]
  factoringRequests    FactoringRequest[]
  logisticsHubs        LogisticsHub[]
  trips                Trip[]
  tripStops            TripStop[]
  outlets              Outlet[]
  supplierAudits       SupplierAudit[]
  payments             Payment[]
  creditFacilities     CreditFacility[]
  consolidatedOrders   ConsolidatedOrder[]
  consolidatedInvoices ConsolidatedInvoice[]
  hotelSuppliers       HotelSupplier[]

  // ── [NEW] Growth Engine ──
  promoCodes PromoCode[]

  // ── [NEW] Arbitration ──
  disputes Dispute[]

  // ── [NEW] INVO Subscriptions (SaaS, not financial) ──
  invoSubscriptions   InvoSubscription[]
  documentProcessings DocumentProcessing[]

  // ── [NEW] Tenant isolation for AgentRun + SwarmJob ──
  agentRuns           AgentRun[]
  swarmJobs           SwarmJob[]
  paymentTransactions PaymentTransaction[]
  etaCredential       EtaCredential?


  // Phase A1: Seat & account limits
  maxUsers  Int @default(5)
  seatCount Int @default(5)

  // V2.0 REFACTOR: New model relations
  rfqRequests         RfqRequest[]
  otpDeliveries       OtpDelivery[]
  returnRequests      ReturnRequest[]
  creditNotes         CreditNote[]
  notifications       Notification[]
  carriers            Carrier[]
  deliveryJobs        DeliveryJob[]
  integrations        Integration[]
  autoAcceptRules     SupplierAutoAcceptRule[]
  apiKeys             ApiKey[]
  webhookEndpoints    WebhookEndpoint[]
  fraudRules          FraudRule[]
  fraudAlerts         FraudAlert[]
  virtualAccounts     VirtualAccount[]
  discountOffers      DynamicDiscountOffer[]
  cashFlowForecasts   CashFlowForecast[]

  // Phase C1: Demand forecasts
  demandForecasts     DemandForecast[]

  // Phase C2: Auto-reorder + stock
  autoReorderRules    AutoReorderRule[]
  stockTransactions   StockTransaction[]

  // Phase D1: Banners
  banners             Banner[]

  // Phase E1: AI Usage
  aiUsages            AiUsage[]
}

enum TenantType {
  HOTEL_GROUP
  SUPPLIER
  FACTORING_COMPANY
  SHIPPING_PROVIDER
  PLATFORM
}

enum TenantStatus {
  ACTIVE
  ACTIVE_DEMO
  INACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────
// ROLE & PERMISSION — Granular RBAC
// ─────────────────────────────────────────

model Role {
  id              String           @id @default(cuid())
  name            String
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isGlobal        Boolean          @default(false)
  permissions     Permission[]
  users           User[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  roles           Role[]
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────
// 1. HOTELS (Buyers)
// ─────────────────────────────────────────

model Hotel {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  legalName     String?
  taxId         String  @unique // ETA Tax Registration Number
  commercialReg String?
  address       String?
  city          String
  governorate   String
  phone         String?
  email         String?
  starRating    Int? // 3, 4, 5, etc.

  roomCount   Int?
  tier        HotelTier   @default(CORE)
  status      HotelStatus @default(ACTIVE)
  creditLimit Decimal?
  creditUsed  Decimal?      @default(0)

  // Risk scoring
  riskScore Int?      @default(50) // 0-100, higher = riskier
  riskTier  RiskTier? @default(MEDIUM)

  // Relations
  properties     Property[]
  users          User[]
  orders         Order[]
  invoices       Invoice[]
  spendRecords   SpendRecord[]
  journalEntries JournalEntry[]
  carts          Cart[]

  consolidatedInvoices ConsolidatedInvoice[]
  mandatedSuppliers    HotelSupplier[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditTransactions CreditTransaction[]
  creditFacilities   CreditFacility[]
  tripStops          TripStop[]
  payments           Payment[]

  // V2.0 REFACTOR: Integration config
  integrations       Integration[]

  // V2.0 REFACTOR: Virtual accounts
  virtualAccounts    VirtualAccount[]

  // V2.0 REFACTOR: Cash flow forecasts
  cashFlowForecasts  CashFlowForecast[]

  // V2.0 REFACTOR: Credit notes
  creditNotes        CreditNote[]

  // V2.0 REFACTOR: Return requests
  returnRequests     ReturnRequest[]

  // V2.0 REFACTOR: RFQ requests
  rfqRequests        RfqRequest[]

  // Phase A1: Seat & account limits
  maxUsers Int @default(10)

  // Phase C1: Demand forecasts
  demandForecasts DemandForecast[]

  // Phase C2: Auto-reorder rules
  autoReorderRules AutoReorderRule[]
}

model Property {
  id          String       @id @default(cuid())
  name        String
  address     String
  city        String
  governorate String
  roomCount   Int?
  type        PropertyType @default(HOTEL)

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  outlets Outlet[]
  orders  Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HotelRiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HotelTier {
  CORE
  PREMIER
  COASTAL
}

enum HotelStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PropertyType {
  HOTEL
  RESORT
  SERVICE_APARTMENT
  BOUTIQUE
}

// ─────────────────────────────────────────
// 2. USERS (Authority Matrix Actors)
// ─────────────────────────────────────────

model User {
  id          String      @id @default(cuid())
  email       String
  name        String
  companyName String?
  phone       String?
  role        UserRole    @default(DEPARTMENT_HEAD)
  status      UserStatus  @default(ACTIVE)
  sector      UserSector?

  // Auth
  passwordHash String?

  // Platform role
  platformRole PlatformRole @default(HOTEL)

  // Tenant & RBAC
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId       String
  assignedRole Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Actor relations
  hotelId String?
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  factoringCompanyId String?
  factoringCompany   FactoringCompany? @relation(fields: [factoringCompanyId], references: [id], onDelete: SetNull)

  // Authority Matrix
  canOverride Boolean @default(false)

  // Delegate invite
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  invitedBy       String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals  OrderApproval[]
  carts      Cart[]
  lastActive DateTime?
  orders     Order[]

  accountType     AccountType @default(BUSINESS)
  emailVerifiedAt DateTime?

  conversations  Conversation[]
  aiUsage        AiUsage?
  addresses      UserAddress[]
  reviews        ProductReview[]
  sampleRequests SampleRequest[]

  // V2.0 REFACTOR: Notification preferences
  notificationPreference NotificationPreference?

  // V2.0 REFACTOR: Notifications
  notifications   Notification[]

  // V2.0 REFACTOR: Carrier relation
  carrierId       String?
  carrier         Carrier?         @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  // Phase A2: Checkout double-verification
  confirmedOrders Order[] @relation("OrderConfirmer")

  // Phase A3: Phone verification
  phoneVerifiedAt DateTime?
  phoneVerificationTokens PhoneVerificationToken[]
  @@index([sector])
  @@unique([tenantId, email])
}

enum UserRole {
  OWNER
  REGIONAL_GM
  GM
  FINANCIAL_CONTROLLER
  DEPARTMENT_HEAD
  CLERK
  RECEIVING_CLERK
}

enum PlatformRole {
  HOTEL
  SUPPLIER
  FACTORING
  SHIPPING
  ADMIN
  MARKETING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserSector {
  PROCUREMENT
  CASHFLOW
  FINTECH
  AI
  HOTEL
  SUPPLIER
  FACTORING
  LOGISTICS
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

// ─────────────────────────────────────────
// 3. SUPPLIERS (Sellers)
// ─────────────────────────────────────────

model Supplier {
  id            String  @id @default(cuid())
  name          String
  legalName     String?
  taxId         String  @unique
  commercialReg String?
  address       String?
  city          String
  governorate   String

  phone   String?
  email   String
  website String?

  description String?
  logoUrl     String?

  status           SupplierStatus @default(PENDING)
  tier             SupplierTier   @default(CORE)
  type             SupplierType   @default(WHOLESALER)
  isVerified       Boolean        @default(false)
  returnPolicyDays Int            @default(14)
  rating           Float?         @default(0)
  reviewCount      Int            @default(0)

  certifications String?

  bankAccount String?
  bankName    String?

  // ── Paymob Integration ──
  paymobMerchantId String?

  // ── INVO SaaS Subscription (replaces old saasSubscriptionPlan) ──
  invoSubscription InvoSubscription?

  products      Product[]
  orders        Order[]
  invoices      Invoice[]
  audits        SupplierAudit[]
  users         User[]
  hotelMandates HotelSupplier[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deliveryZones DeliveryZone[]

  // Document processing records
  documentProcessings DocumentProcessing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // V2.0 REFACTOR: Auto-accept rules
  autoAcceptRules SupplierAutoAcceptRule?

  // V2.0 REFACTOR: Reliability score
  reliabilityScore Float?  @default(0)
  fulfillmentRate  Float?  @default(0)
  returnRate       Float?  @default(0)
  avgResponseTime  Int?

  // V2.0 REFACTOR: API keys
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  // V2.0 REFACTOR: Credit notes
  creditNotes      CreditNote[]

  // V2.0 REFACTOR: RFQ responses
  rfqResponses     RfqResponse[]

  // V2.0 REFACTOR: Dynamic discount offers
  discountOffers   DynamicDiscountOffer[]

  // Phase C2: Auto-reorder rules
  autoReorderRules AutoReorderRule[]

  @@unique([tenantId, email])
}

model DeliveryZone {
  id      String @id @default(cuid())
  zone    String
  minDays Int
  maxDays Int
  fee     Decimal

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum SupplierStatus {
  PENDING
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SupplierTier {
  CORE
  PREMIER
  COASTAL
  VERIFIED
}

enum SupplierType {
  FACTORY
  WHOLESALER
  RETAILER
}

// ─────────────────────────────────────────
// 4. PRODUCTS (Catalog)
// ─────────────────────────────────────────

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  description String?
  category    ProductCategory
  subcategory String?

  unitPrice Decimal
  currency  String @default("EGP")

  volumeTiers String?

  stockQuantity Int       @default(0)
  minOrderQty   Int       @default(1)
  leadTimeDays  Int       @default(1)
  reorderPoint  Int       @default(10)
  reorderQty    Int       @default(50)
  avgDailyUsage Float     @default(0)
  lastCountedAt DateTime?
  aiForecast    String?

  unitOfMeasure  String  @default("piece")
  shelfLifeDays  Int?
  temperatureReq String?

  images String?
  specs  String?

  status ProductStatus @default(ACTIVE)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderItems         OrderItem[]
  inventorySnapshots InventorySnapshot[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cartItems CartItem[]
  reviews   ProductReview[]

  // V2.0 REFACTOR: Barcode support
  barcode         String?
  barcodeType     String?

  // V2.0 REFACTOR: AI classification
  aiCategory      String?
  aiConfidence    Float?
  aiClassifiedAt  DateTime?
  manuallyVerified Boolean @default(false)

  // V2.0 REFACTOR: RFQ items
  rfqItems        RfqItem[]

  // Phase C1: Demand forecasts
  demandForecasts DemandForecast[]

  // Phase C2: Auto-reorder + stock
  autoReorderRules AutoReorderRule[]
  stockTransactions StockTransaction[]
}

enum ProductCategory {
  F_AND_B
  CONSUMABLES
  GUEST_SUPPLIES
  FFE
  SERVICES
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

// ─────────────────────────────────────────
// 5. ORDERS (Purchase Orders)
// ─────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String

  status OrderStatus @default(DRAFT)

  subtotal  Decimal
  vatAmount Decimal
  total     Decimal
  currency  String @default("EGP")

  deliveryDate         DateTime?
  deliveryInstructions String?

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Restrict)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items     OrderItem[]
  approvals OrderApproval[]
  invoices  Invoice[]

  etaSubmissionId String? @unique

  // Payment guarantee (operated by licensed third-party, not platform)
  paymentGuaranteed      Boolean   @default(false)
  paymentGuaranteeMethod String? // FACTORING_PARTNER, DIRECT, WAIVED
  paymentGuaranteeSetAt  DateTime?

  checkoutGroupId   String?
  shippingMethod    String?
  shippingCost      Decimal?    @default(0)
  estimatedDelivery DateTime?

  poNumber        String?
  costCenter      String?
  deliveryAddress String?

  disputes Dispute[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditTransactions CreditTransaction[]
  tripStops          TripStop[]

  // V2.0 REFACTOR: RFQ support
  rfqId              String?
  rfq                RfqRequest?         @relation("RfqOrder", fields: [rfqId], references: [id])
  orderType          OrderType           @default(DIRECT)

  // V2.0 REFACTOR: OTP delivery (one-to-many: multiple attempts/retries)
  otpDeliveries      OtpDelivery[]

  // V2.0 REFACTOR: Split order support
  parentOrderId      String?
  parentOrder        Order?              @relation("OrderSplit", fields: [parentOrderId], references: [id])
  childOrders        Order[]             @relation("OrderSplit")
  isSplitOrder       Boolean             @default(false)

  // V2.0 REFACTOR: Return support
  returnRequests      ReturnRequest[]

  // V2.0 REFACTOR: Delivery jobs
  deliveryJobs        DeliveryJob[]

  // Phase A2: Checkout double-verification
  confirmationToken String? @unique
  confirmationSentAt DateTime?
  confirmedById String?
  confirmedAt DateTime?
  confirmedBy User? @relation("OrderConfirmer", fields: [confirmedById], references: [id])
  @@unique([tenantId, orderNumber])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Decimal
  total     Decimal

  receivedQuantity Int?
  returnedQuantity Int?    @default(0)
  returnReason     String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  notes String?

  // V2.0 REFACTOR: Return items
  returnItems ReturnItem[]
}

model OrderApproval {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])

  action ApprovalAction
  reason String?

  beforeState String?
  afterState  String?

  // Phase A4: Authority chain workflow
  stepIndex Int @default(0)

  createdAt DateTime @default(now())

  @@index([orderId, approverId])
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PENDING_CONFIRMATION
  REJECTED
  CONFIRMED
  IN_TRANSIT
  PARTIALLY_DELIVERED
  DELIVERED
  DISPUTED
  CANCELLED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  ESCALATED
  AUTO_APPROVED
  ADMIN_OVERRIDE
  PENDING_CHAIN_APPROVAL
}

// ─────────────────────────────────────────
// 6. INVOICES (ETA E-Invoicing)
// ─────────────────────────────────────────

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String

  // ETA Compliance
  etaUuid          String?   @unique
  etaStatus        EtaStatus @default(PENDING)
  digitalSignature String?
  submissionLog    String?

  // ETA Dual-Language Fields (bilingual invoice line items per ETA V2 spec)
  codeName    String? // Product/service code name (English)
  codeNameAr  String? // Product/service code name (Arabic) — اسم الكود
  description String? // Line item description (English)
  descriptionAr String? // Line item description (Arabic) — الوصف

  // Financial
  subtotal  Decimal
  vatRate   Decimal  @default(14.00)
  vatAmount Decimal
  total     Decimal
  currency  String @default("EGP")

  returnedAmount       Decimal?    @default(0)
  retentionRate        Decimal?    @default(0)
  retentionAmount      Decimal?    @default(0)
  netPayable           Decimal?
  retentionReleaseDate DateTime?

  issueDate DateTime
  dueDate   DateTime?
  paidDate  DateTime?

  status        InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  consolidatedInvoiceId String?
  consolidatedInvoice   ConsolidatedInvoice? @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: SetNull)

  // ── Document processing (platform service, NOT financial spread) ──
  documentProcessing DocumentProcessing?

  // Factoring — operated by licensed third-party partner only
  // The platform does NOT hold cash or charge factoring fees
  factoringStatus      FactoringStatus    @default(NOT_FACTORABLE)
  factoringCompanyId   String?
  factoringCompany     FactoringCompany?  @relation(fields: [factoringCompanyId], references: [id], onDelete: SetNull)
  factoringRequests    FactoringRequest[]
  acceleratedCashRate  Decimal            @default(0) // Early payment discount rate applied
  supplierDiscountRate Decimal            @default(0) // Supplier's cash discount rate for early payment
  cashDiscountDelta    Decimal            @default(0) // Delta between supplier discount and factoring fee

  // Platform & admin fee fields
  platformFee         Decimal @default(0) // Platform fee charged per invoice
  platformFeeRate     Decimal @default(0) // Platform fee percentage rate
  hotelAdminFeeRate   Decimal @default(0) // Hotel admin fee percentage
  hotelAdminFeeAmount Decimal @default(0) // Calculated hotel admin fee amount

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  payments           Payment[]
  creditTransactions CreditTransaction[]

  // V2.0 REFACTOR: Credit notes
  creditNotes        CreditNote[]

  // V2.0 REFACTOR: Dynamic discounting
  discountOffers     DynamicDiscountOffer[]

  // V2.0 REFACTOR: Virtual account
  virtualAccountId   String?
  virtualAccount     VirtualAccount?     @relation(fields: [virtualAccountId], references: [id])

  @@unique([tenantId, invoiceNumber])
}

enum EtaStatus {
  PENDING
  SUBMITTING
  ACCEPTED
  REJECTED
  RETRYING
  MANUAL_RESOLUTION
}

model EtaCredential {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId     String
  clientSecret String // AES-256-GCM encrypted
  taxId        String
  environment  String    @default("preprod") // preprod | production
  isActive     Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SUBMITTED
  VALIDATED
  DISPUTED
  CREDIT_NOTE
}

enum PaymentStatus {
  PENDING
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  FACTORED // Paid by licensed factoring partner, not platform
}

enum FactoringStatus {
  NOT_FACTORABLE
  AVAILABLE
  OFFERED
  ACCEPTED
  PAID
  LOCKED_BY_MASTER
}

// ─────────────────────────────────────────
// 7. AUTHORITY MATRIX (Governance)
// ─────────────────────────────────────────

model AuthorityRule {
  id String @id @default(cuid())

  role         UserRole
  minValue     Decimal
  maxValue     Decimal
  category     String?
  supplierTier String?

  hotelRiskTier HotelRiskTier?
  hotelTier     HotelTier?

  requesterRole UserRole?

  requiresPaymentGuarantee Boolean @default(false)
  requiresEtaValidation    Boolean @default(false)
  requiresDualSignOff      Boolean @default(false)

  action AuthorityAction

  routeToRole UserRole?

  // Phase A4: Authority chain workflow
  approvalChain String? // JSON array of roles: ["GM", "FINANCIAL_CONTROLLER"]

  // Phase D2: Factoring eligibility
  canRequestFactoring Boolean @default(false)

  hotelId  String?
  tenantId String?

  name        String?
  description String?
  priority    Int     @default(0)
