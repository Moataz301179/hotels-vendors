model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  family    String   // Token family — all tokens from the same initial grant
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?  // ID of the token that replaced this one (rotation chain)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([tokenHash])
}

// ─────────────────────────────────────────
// 25. USER ADDRESSES
// ─────────────────────────────────────────

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  address     String
  city        String
  governorate String
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// 26. AI CHAT
// ─────────────────────────────────────────

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  role      String
  title     String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@index([tenantId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  tokensUsed     Int?
  latencyMs      Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AiUsage {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messagesToday Int      @default(0)
  tokensToday   Int      @default(0)
  messagesTotal Int      @default(0)
  tokensTotal   Int      @default(0)
  quotaResetAt  DateTime @default(now())
  plan          AiPlan   @default(FREE)
  updatedAt     DateTime @updatedAt
}

enum AiPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────
// 27. PRODUCT REVIEWS
// ─────────────────────────────────────────

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String?
  images    String?
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

// ─────────────────────────────────────────
// 28. SAMPLE REQUESTS
// ─────────────────────────────────────────

model SampleRequest {
  id              String       @id @default(cuid())
  productId       String
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId         String?
  status          SampleStatus @default(PENDING)
  quantity        Int          @default(1)
  notes           String?
  deliveryAddress String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum SampleStatus {
  PENDING
  APPROVED
  SHIPPED
  DELIVERED
  CANCELLED
}

// ─────────────────────────────────────────
// 29. WAITING LIST
// ─────────────────────────────────────────

model WaitingListEntry {
  id     String            @id @default(cuid())
  email  String
  role   String
  source String            @default("beta-launch")
  status WaitingListStatus @default(PENDING)

  referrer String?
  notes    String?

  invitedAt   DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([email, source])
  @@index([status, role])
  @@index([createdAt])
}

enum WaitingListStatus {
  PENDING
  INVITED
  CONVERTED
  DECLINED
}

// ─────────────────────────────────────────
// 30. SOCIAL MEDIA CAMPAIGNS
// ─────────────────────────────────────────

model SocialCampaign {
  id          String  @id @default(cuid())
  name        String
  description String?

  objective   CampaignObjective
  targetRoles String[]
  platforms   SocialPlatform[]

  budgetEgp Float?
  startDate DateTime
  endDate   DateTime?

  status CampaignStatus @default(DRAFT)

  contentStrategy String?
  metrics         String?

  posts SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, objective])
  @@index([startDate])
}

model SocialPost {
  id         String         @id @default(cuid())
  campaignId String
  campaign   SocialCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  platform  SocialPlatform
  content   String
  mediaUrls String?
  hashtags  String?

  scheduledAt DateTime
  publishedAt DateTime?

  status PostStatus @default(DRAFT)

  engagement String?

  swarmJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([campaignId])
  @@index([platform])
}

model SocialAudience {
  id          String  @id @default(cuid())
  name        String
  description String?

  platforms SocialPlatform[]
  roles     String[]
  locations String[]
  interests String[]

  estimatedReach Int?

  campaignIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CampaignObjective {
  AWARENESS
  ENGAGEMENT
  CONVERSION
  RETENTION
  LEAD_GENERATION
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  YOUTUBE
  TIKTOK
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHED
  FAILED
}

// ─────────────────────────────────────────
// 31. CASHFLOW COMPASS
// ─────────────────────────────────────────

model CompassReading {
  id   String   @id @default(cuid())
  date DateTime @unique @default(now())

  marketDirection String @default("STABLE")
  confidence      Int    @default(60)

  priceVelocity         String?
  paymentDynamics       String?
  macroIndicators       String?
  platformMetrics       String?
  alerts                String?
  pricingAdjustments    String?
  creditRecommendations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// 32. CREDIT LINE APPLICATION
// ─────────────────────────────────────────

model CreditLineApplication {
  id     String @id @default(cuid())
  status String @default("PENDING_REVIEW")

  hotelName      String
  brand          String?
  properties     Int?
  rooms          Int?
  governorate    String?
  address        String?
  crNumber       String
  taxId          String
  tourismLicense String?
  gmName         String?
  gmPhone        String?
  gmEmail        String?
  cfoName        String?
  cfoPhone       String?

  annualRevenue      Float?
  netProfit          Float?
  totalAssets        Float?
  currentAssets      Float?
  totalLiabilities   Float?
  currentLiabilities Float?
  bankBalance        Float?
  monthlyPurchases   Float?
  avgPaymentDays     Float?
  existingDebt       Float?

  propertyDeed        Boolean @default(false)
  bankGuarantee       Boolean @default(false)
  personalGuarantee   Boolean @default(false)
  equipmentCollateral Boolean @default(false)
  depositAmount       Float?

  creditScore      Int?
  recommendedLimit Float?
  aiAnalysisReport String? @db.Text
  aiRiskFlags      String?

  factoringCompanyId   String?
  approvedLimit        Float?
  approvedInterestRate Float?
  approvedAt           DateTime?

  rejectedReason String?

  documents String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// 33. PROMO & REFERRAL ENGINE
// ─────────────────────────────────────────

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  discountType PromoType
  value        Float
  maxUses      Int?
  usedCount    Int       @default(0)

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}

enum PromoType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  SAAS_TRIAL
}

// ─────────────────────────────────────────
// 34. DISPUTE & ARBITRATION ENGINE
// ─────────────────────────────────────────

model Dispute {
  id            String @id @default(cuid())
  disputeNumber String @unique

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  reason         String
  evidenceUrls   String?
  amountDisputed Float

  status     DisputeStatus        @default(OPEN)
  resolution String?
  liability  LiabilityAssignment?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

enum DisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  ESCALATED_TO_CPA
  RESOLVED
  CLOSED
}

enum LiabilityAssignment {
  HOTEL
  SUPPLIER
  LOGISTICS
  PLATFORM
  SPLIT_LIABILITY
}

// ─────────────────────────────────────────
// 35. SUBSCRIPTION TIERS (Legacy — replaced by InvoSubscription)
// ─────────────────────────────────────────

enum SubscriptionTier {
  STANDARD
  ENTERPRISE_COWORKER
}

// ─────────────────────────────────────────
// 36. LEAD CAPTURE — Landing Page Sector Router
// ─────────────────────────────────────────

model LeadCapture {
  id          String     @id @default(cuid())
  companyName String
  email       String
  sector      UserSector
  role        String? // optional: hotel, supplier, factoring, logistics
  message     String?
  source      String? // which page/form captured the lead
  status      String     @default("new") // new, contacted, qualified, converted
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sector])
  @@index([email])
  @@index([status])
}
