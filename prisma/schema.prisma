  CANCELLED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  QUALITY_ISSUE
  OVER_DELIVERED
  EXPIRED
  NEAR_EXPIRY
  OTHER
}

enum ReturnItemStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_APPROVED
}

enum ReturnResolution {
  FULL_RETURN
  PARTIAL_RETURN
  REPLACEMENT
  CREDIT_NOTE
  REFUND
  REJECTED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  REFUNDED
  CANCELLED
}

// ─────────────────────────────────────────
// 40. NOTIFICATION SYSTEM
// ─────────────────────────────────────────

model Notification {
  id              String              @id @default(cuid())

  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type            NotificationType
  title           String
  body            String
  priority        NotificationPriority @default(NORMAL)

  entityType      String?
  entityId        String?

  readAt          DateTime?
  sentViaEmail    Boolean             @default(false)
  sentViaSms      Boolean             @default(false)
  sentViaPush     Boolean             @default(false)

  actionUrl       String?

  createdAt       DateTime            @default(now())
  expiresAt       DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([tenantId])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferences     String

  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String   @default("Africa/Cairo")

  updatedAt       DateTime @updatedAt
}

enum NotificationType {
  ORDER_CREATED
  ORDER_APPROVED
  ORDER_REJECTED
  ORDER_CONFIRMED_BY_SUPPLIER
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_DISPUTED
  ORDER_CANCELLED

  RFQ_PUBLISHED
  RFX_RESPONSE_RECEIVED
  RFX_AWARDED

  OTP_GENERATED
  DELIVERY_CONFIRMED
  DELIVERY_FAILED

  INVOICE_SUBMITTED
  INVOICE_VALIDATED
  INVOICE_DISPUTED
  INVOICE_PAID

  FACTORING_REQUESTED
  FACTORING_BID_RECEIVED
  FACTORING_ACCEPTED
  FACTORING_DISBURSED

  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  CREDIT_NOTE_ISSUED

  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  PAYMENT_REMINDER

  CREDIT_LIMIT_WARNING
  CREDIT_SCORE_UPDATED
  FRAUD_ALERT
  SYSTEM_MAINTENANCE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─────────────────────────────────────────
// 41. CARRIER / SHIPPING MANAGEMENT
// ─────────────────────────────────────────

model Carrier {
  id              String         @id @default(cuid())
  name            String
  legalName       String?
  taxId           String?        @unique
  commercialReg   String?

  contactEmail    String?
  contactPhone    String?
  contactPerson   String?

  fleetSize       Int?
  hasReefer       Boolean        @default(false)
  hasFrozen       Boolean        @default(false)
  hasChilled      Boolean        @default(false)

  coverageAreas   String?

  status          CarrierStatus  @default(PENDING_VERIFICATION)
  reliabilityScore Float?        @default(0)
  rating          Float?         @default(0)

  bankAccount     String?
  bankName        String?
  paymentTerms    String         @default("NET_48")

  users           User[]
  rates           CarrierRate[]
  deliveryJobs    DeliveryJob[]

  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([tenantId])
}

model CarrierRate {
  id              String           @id @default(cuid())
  carrierId       String
  carrier         Carrier          @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  fromGovernorate String
  toGovernorate   String
  fromCity        String?
  toCity          String?

  rateType        CarrierRateType  @default(PER_KG)
  baseRate        Decimal
  minCharge       Decimal?
  fuelSurcharge   Decimal?         @default(0)
  currency        String           @default("EGP")

  minWeight       Decimal?
  maxWeight       Decimal?
  estimatedDays   Int?

  temperatureZone TemperatureZone  @default(AMBIENT)

  validFrom       DateTime         @default(now())
  validUntil      DateTime?
  isActive        Boolean          @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([carrierId, fromGovernorate, toGovernorate])
}

model DeliveryJob {
  id              String             @id @default(cuid())
  jobNumber       String             @unique

  carrierId       String
  carrier         Carrier            @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tripId          String?
  trip            Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripStopId      String?
  tripStop        TripStop?          @relation(fields: [tripStopId], references: [id], onDelete: SetNull)

  pickupAddress   String
  pickupContact   String?
  pickupPhone     String?
  pickupDate      DateTime?
  pickedUpAt      DateTime?

  deliveryAddress String
  deliveryContact String?
  deliveryPhone   String?
  deliveryDate    DateTime?
  deliveredAt     DateTime?

  status          DeliveryJobStatus  @default(ASSIGNED)

  shippingCost    Decimal
  platformFee     Decimal           @default(0)
  carrierPayout   Decimal           @default(0)
  currency        String            @default("EGP")
  paidToCarrier   Boolean           @default(false)
  carrierPaidAt   DateTime?

  podPhotoUrl     String?
  signatureUrl    String?
  otpDeliveryId   String?           @unique
  otpDelivery     OtpDelivery?       @relation(fields: [otpDeliveryId], references: [id])

  temperatureLog  String?
  tempViolation   Boolean           @default(false)

  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([carrierId, status])
  @@index([orderId])
  @@index([status, deliveryDate])
}

enum CarrierStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum CarrierRateType {
  PER_KG
  PER_KM
  PER_TRIP
  FLAT_RATE
}

enum TemperatureZone {
  AMBIENT
  CHILLED
  FROZEN
}

enum DeliveryJobStatus {
  ASSIGNED
  ACCEPTED_BY_CARRIER
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

// ─────────────────────────────────────────
// 42. ERP/PMS INTEGRATION LAYER
// ─────────────────────────────────────────

model Integration {
  id              String           @id @default(cuid())

  hotelId         String
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  integrationType IntegrationType
  providerName    String

  config          String
  credentials     String?

  syncDirection   SyncDirection    @default(BIDIRECTIONAL)
  syncFrequency   SyncFrequency    @default(HOURLY)
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  isActive        Boolean          @default(true)

  fieldMapping    String?

  logs            ConnectorLog[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([hotelId, integrationType])
}

model ConnectorLog {
  id              String       @id @default(cuid())
  integrationId   String
  integration     Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  syncType        String
  direction       String
  status          String
  recordsProcessed Int?
  recordsFailed   Int?
  errorMessage    String?
  details         String?

  startedAt       DateTime
  completedAt     DateTime?

  createdAt       DateTime     @default(now())

  @@index([integrationId, createdAt])
}

enum IntegrationType {
  OPERA_CLOUD
  OPERA_ON_PREMISE
  PROTEL
  SAP
  ORACLE_ERP
  SUN_FINANCE
  CSV_EXCEL
  API_DIRECT
  MANUAL
}

enum SyncDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum SyncFrequency {
  REALTIME
  EVERY_15_MIN
  HOURLY
  DAILY
  WEEKLY
  MANUAL
}

// ─────────────────────────────────────────
// 43. SUPPLIER AUTO-ACCEPT RULES
// ─────────────────────────────────────────

model SupplierAutoAcceptRule {
  id              String   @id @default(cuid())
  supplierId      String   @unique
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isActive        Boolean  @default(true)

  maxOrderAmount  Decimal?
  maxQuantity     Json?
  categories      ProductCategory[]
  excludedProducts String?

  useListedPrice  Boolean  @default(true)
  autoDiscount    Json?

  notifyOnAutoAccept Boolean @default(true)
  alertOnLargeOrder  Boolean  @default(true)
  largeOrderThreshold Decimal?

  redFlags        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────
// 44. API KEY MANAGEMENT
// ─────────────────────────────────────────

model ApiKey {
  id              String       @id @default(cuid())
  keyHash         String       @unique
  keyPrefix       String

  name            String
  description     String?

  supplierId      String?
  supplier        Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  scopes          String[]
  rateLimitPerMinute Int       @default(60)

  status          ApiKeyStatus @default(ACTIVE)
  lastUsedAt      DateTime?
  expiresAt       DateTime?

  webhooks        WebhookEndpoint[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([supplierId])
  @@index([tenantId])
  @@index([keyPrefix])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  url             String
  secret          String

  events          String[]

  apiKeyId        String?
  apiKey          ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([apiKeyId])
  @@index([supplierId])
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ─────────────────────────────────────────
// 45. FRAUD DETECTION
// ─────────────────────────────────────────

model FraudRule {
  id              String           @id @default(cuid())
  name            String
  description     String?
  ruleType        FraudRuleType
  config          String
  severity        FraudSeverity    @default(MEDIUM)
  isActive        Boolean          @default(true)
  autoAction      FraudAutoAction  @default(ALERT_ONLY)

  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  alerts          FraudAlert[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model FraudAlert {
  id              String            @id @default(cuid())
  ruleId          String
  rule            FraudRule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  entityType      String
  entityId        String
  description     String
  evidence        String?

  severity        FraudSeverity
  status          FraudAlertStatus  @default(OPEN)

  resolvedById    String?
  resolvedAt      DateTime?
  resolution      String?

  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([entityType, entityId])
  @@index([status, severity])
}

enum FraudRuleType {
  PRICE_ANOMALY
  DUPLICATE_INVOICE
  UNUSUAL_ORDER
  PHANTOM_SUPPLIER
  RAPID_FIRE
  CIRCULAR_TRADING
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAutoAction {
  ALERT_ONLY
  FLAG_FOR_REVIEW
  BLOCK_TRANSACTION
  SUSPEND_ENTITY
}

enum FraudAlertStatus {
  OPEN
  UNDER_INVESTIGATION
  CONFIRMED_FRAUD
  FALSE_POSITIVE
  RESOLVED
}

// ─────────────────────────────────────────
// 46. VIRTUAL ACCOUNTS & DYNAMIC DISCOUNTING
// ─────────────────────────────────────────

model VirtualAccount {
  id              String               @id @default(cuid())
  accountNumber   String               @unique

  hotelId         String
  hotel           Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  balance         Decimal              @default(0)
  currency        String               @default("EGP")

  bankName        String?
  bankAccountNumber String?

  status          VirtualAccountStatus @default(ACTIVE)

  // V2.0 REFACTOR: Invoices linked to this virtual account
  invoices        Invoice[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([hotelId])
}

model DynamicDiscountOffer {
  id              String              @id @default(cuid())

  invoiceId       String
  invoice         Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  originalDueDate DateTime
  earlyPayDate    DateTime
  discountPercent Decimal
  discountAmount  Decimal
  earlyPayAmount  Decimal

  status          DiscountOfferStatus @default(PENDING)

  acceptedAt      DateTime?
  paidAt          DateTime?

  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([invoiceId])
  @@index([status])
}

model CashFlowForecast {
  id              String   @id @default(cuid())

  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  forecastDate    DateTime
  period          String

  expectedOutflows Decimal
  expectedInflows  Decimal
  netPosition      Decimal

  recommendations  String?

  actualOutflows   Decimal?
  accuracyScore    Float?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([hotelId, period])
}

enum VirtualAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DiscountOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  PAID
}

// ─────────────────────────────────────────
// 47. ORDER TYPE ENUM
// ─────────────────────────────────────────

enum OrderType {
  DIRECT
  RFQ
  AI_GENERATED
  AUTO_REORDER
}

// ─────────────────────────────────────────
// Phase C1: Demand Forecast
// ─────────────────────────────────────────

model DemandForecast {
  id              String   @id @default(cuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  forecastDate    DateTime
  predictedQuantity Decimal
  confidence      Decimal
  modelVersion    String
  actualQuantity  Decimal?
  accuracyScore   Decimal?
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, forecastDate])
  @@index([productId])
}

// ─────────────────────────────────────────
// Phase C2: Auto-Reorder
// ─────────────────────────────────────────

model AutoReorderRule {
  id              String   @id @default(cuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  minStock        Decimal
  reorderQuantity Decimal
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, productId])
  @@index([isActive])
}

model StockTransaction {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Decimal
  type            StockTransactionType
  referenceType   String?  // ORDER, ADJUSTMENT, REORDER
  referenceId     String?
  balanceAfter    Decimal
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type])
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
}

// ─────────────────────────────────────────
// Phase D1: Advertisement Banners
// ─────────────────────────────────────────

model Banner {
  id              String   @id @default(cuid())
  title           String
  subtitle        String?
  imageUrl        String
  targetUrl       String
  placement       BannerPlacement
  startDate       DateTime
  endDate         DateTime
  maxImpressions  Int?
  impressionCount Int      @default(0)
  clickCount      Int      @default(0)
  isActive        Boolean  @default(true)
  targetAudience  BannerAudience @default(ALL)
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([placement, isActive])
  @@index([startDate, endDate])
}

enum BannerPlacement {
  HOMEPAGE_HERO
  DASHBOARD_SIDEBAR
  CATALOG_TOP
  CHECKOUT_BOTTOM
}

enum BannerAudience {
  ALL
  HOTEL
  SUPPLIER
}
