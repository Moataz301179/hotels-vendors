// ─────────────────────────────────────────
// A. BIDDING / RFQ SYSTEM
// ─────────────────────────────────────────

/// RFQ (Request for Quotation) — Created by hotels for large/complex orders.
/// Replaces the need for manual supplier outreach.
model RfqRequest {
  id          String   @id @default(cuid())
  rfqNumber   String   @unique
  title       String
  description String?

  status      RfqStatus @default(DRAFT)

  // Who created it
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String

  // Timing
  responseDeadline DateTime
  expectedDeliveryDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    @updatedAt
  publishedAt  DateTime?
  closedAt     DateTime?

  // What's being requested
  items        RfqItem[]
  responses    RfqResponse[]

  // Selected winner (after bidding)
  selectedResponseId String?
  selectedResponse   RfqResponse? @relation("SelectedResponse", fields: [selectedResponseId], references: [id])
  selectionReason    String?

  // Auto-convert to PO after selection
  autoConvertToPo Boolean @default(true)
  generatedOrderId String?

  @@index([hotelId, status])
  #[index([tenantId, status])
  #[index([responseDeadline])
}

model RfqItem {
  id          String   @id @default(cuid())
  rfqId       String
  rfq         RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  productCategory ProductCategory
  productName     String
  description     String?
  quantity        Int
  unitOfMeasure   String  @default("kg")
  qualitySpecs    String?

  // Optional: link to existing product
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Target price (optional, for reference)
  targetPrice     Decimal?
  currency        String  @default("EGP")

  responses       RfqItemResponse[]

  createdAt       DateTime @default(now())
}

/// Supplier's response to an RFQ
model RfqResponse {
  id              String   @id @default(cuid())
  rfqId           String
  rfq             RfqRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  status          RfqResponseStatus @default(DRAFT)

  // Supplier's overall terms
  totalPrice      Decimal
  currency        String   @default("EGP")
  deliveryDays    Int
  shippingMethod  ShippingMethod @default(SUPPLIER_SELF)
  notes           String?
  validUntil      DateTime

  // Line item responses
  items           RrfqItemResponse[]

  // Winner selection
  selectedOrders  RfqRequest[] @relation("SelectedResponse")
  rank            Int?         // 1 = best price, 2 = second best, etc.

  submittedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([rfqId, supplierId])
  @@index([rfqId, status])
  @@index([supplierId])
}

model RfqItemResponse {
  id              String   @id @default(cuid())
  rfqResponseId   String
  rfqResponse     RfqResponse @relation(fields: [rfqResponseId], references: [id], onDelete: Cascade)
  rfqItemId       String
  rfqItem         RfqItem  @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

  unitPrice       Decimal
  availableQuantity Int
  totalPrice      Decimal
  deliveryDays    Int
  notes           String?

  isPartial       Boolean  @default(false)  // Can't fulfill full quantity
}

enum RfqStatus {
  DRAFT
  PUBLISHED
  OPEN          // Accepting responses
  CLOSED        // Deadline passed, evaluating
  AWARDED       // Winner selected
  CONVERTED_TO_PO
  CANCELLED
  EXPIRED
}

enum RfqResponseStatus {
  DRAFT
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ShippingMethod {
  SUPPLIER_SELF     // Supplier delivers themselves
  PLATFORM_LOGISTICS // Shark-Breaker hub model
  THIRD_PARTY       // External carrier
}

// ─────────────────────────────────────────
// B. OTP DELIVERY CONFIRMATION
// ─────────────────────────────────────────

/// OTP for delivery confirmation. Generated when delivery person arrives.
/// Hotel receiver enters OTP to confirm receipt of goods.
model OtpDelivery {
  id              String   @id @default(cuid())
  otpCode         String   @unique  // 6-digit code

  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tripStopId      String?
  tripStop        TripStop? @relation(fields: [tripStopId], references: [id], onDelete: SetNull)

  // Who receives the OTP
  receiverName    String?
  receiverPhone   String
  receiverUserId  String?

  // OTP lifecycle
  status          OtpStatus @default(PENDING)
  generatedAt     DateTime  @default(now())
  expiresAt       DateTime
  verifiedAt      DateTime?
  verifiedById    String?

  // Delivery details at time of confirmation
  deliveryPhotoUrl String?
  signatureUrl     String?
  notes            String?

  // If OTP expired, a new one can be generated
  parentOtpId     String?
  parentOtp       OtpDelivery? @relation("OtpRetry", fields: [parentOtpId], references: [id])
  retries         OtpDelivery[] @relation("OtpRetry")

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([otpCode])
  @@index([status, expiresAt])
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  CANCELLED
  MAX_RETRIES_EXCEEDED
}

// ─────────────────────────────────────────
// C. RETURN & CREDIT NOTE WORKFLOW
// ─────────────────────────────────────────

/// Return request initiated by hotel after delivery
model ReturnRequest {
  id              String   @id @default(cuid())
  returnNumber    String   @unique

  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Who initiated
  initiatedById   String
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status          ReturnStatus @default(PENDING_SUPPLIER_RESPONSE)

  reason          ReturnReason
  description     String?
  evidenceUrls    String?   // JSON array of photo URLs

  // Items being returned
  items           ReturnItem[]

  // Resolution
  resolution      ReturnResolution?
  resolvedAt      DateTime?
  resolvedById    String?

  // Financial impact
  totalReturnAmount Decimal @default(0)
  creditNoteId      String?
  creditNote        CreditNote? @relation(fields: [creditNoteId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId, status])
  @@index([hotelId])
  @@index([tenantId])
}

model ReturnItem {
  id              String   @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity        Int
  reason          ReturnReason
  description     String?
  evidenceUrls    String?

  // Resolution per item
  status          ReturnItemStatus @default(PENDING)
  approvedQuantity Int?
  rejectedReason  String?
  refundAmount    Decimal?

  createdAt       DateTime @default(now())
}

/// Credit note issued when return is approved
model CreditNote {
  id              String   @id @default(cuid())
  creditNoteNumber String  @unique

  returnRequest   ReturnRequest?

  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status          CreditNoteStatus @default(ISSUED)

  subtotal        Decimal
  vatAmount       Decimal
  total           Decimal
  currency        String   @default("EGP")

  // How the credit is applied
  appliedToInvoiceId String?
  refundedAmount     Decimal?  // If refunded instead of credited

  issuedAt        DateTime @default(now())
  appliedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([supplierId])
  @@index([hotelId])
}

enum ReturnStatus {
  PENDING_SUPPLIER_RESPONSE
  SUPPLIER_ACCEPTED
  SUPPLIER_REJECTED
  PARTIALLY_ACCEPTED
  UNDER_INVESTIGATION
  ESCALATED_TO_ADMIN
  RESOLVED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  QUALITY_ISSUE
  OVER_DELIVERED
  EXPIRED
  NEAR_EXPIRY
  OTHER
}

enum ReturnItemStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_APPROVED
}

enum ReturnResolution {
  FULL_RETURN
  PARTIAL_RETURN
  REPLACEMENT
  CREDIT_NOTE
  REFUND
  REJECTED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  REFUNDED
  CANCELLED
}

// ─────────────────────────────────────────
// D. NOTIFICATION SYSTEM
// ─────────────────────────────────────────

/// Notification for any user action or system event
model Notification {
  id              String   @id @default(cuid())

  // Who receives it
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // What happened
  type            NotificationType
  title           String
  body            String
  priority        NotificationPriority @default(NORMAL)

  // Related entity
  entityType      String?  // "Order", "Invoice", "RfqRequest", etc.
  entityId        String?

  // Delivery channels
  channels        NotificationChannel[]

  // Status
  readAt          DateTime?
  sentViaEmail    Boolean   @default(false)
  sentViaSms      Boolean   @default(false)
  sentViaPush     Boolean   @default(false)

  // Action link
  actionUrl       String?

  createdAt       DateTime @default(now())
  expiresAt       DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([tenantId])
}

/// User's notification preferences
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-type preferences
  preferences     String   // JSON: { "ORDER_CONFIRMED": { "email": true, "sms": false, "push": true }, ... }

  // Quiet hours
  quietHoursStart String?  // "22:00"
  quietHoursEnd   String?  // "08:00"
  timezone        String   @default("Africa/Cairo")

  updatedAt       DateTime @updatedAt
}

enum NotificationType {
  // Order events
  ORDER_CREATED
  ORDER_APPROVED
  ORDER_REJECTED
  ORDER_CONFIRMED_BY_SUPPLIER
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_DISPUTED
  ORDER_CANCELLED

  // RFQ events
  RFQ_PUBLISHED
  RFX_RESPONSE_RECEIVED
  RFX_AWARDED

  // Delivery events
  OTP_GENERATED
  DELIVERY_CONFIRMED
  DELIVERY_FAILED

  // Invoice events
  INVOICE_SUBMITTED
  INVOICE_VALIDATED
  INVOICE_DISPUTED
  INVOICE_PAID

  // Factoring events
  FACTORING_REQUESTED
  FACTORING_BID_RECEIVED
  FACTORING_ACCEPTED
  FACTORING_DISBURSED

  // Return events
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  CREDIT_NOTE_ISSUED

  // Payment events
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  PAYMENT_REMINDER

  // System events
  CREDIT_LIMIT_WARNING
  CREDIT_SCORE_UPDATED
  FRAUD_ALERT
  SYSTEM_MAINTENANCE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

// ─────────────────────────────────────────
// E. CARRIER / SHIPPING MANAGEMENT
// ─────────────────────────────────────────

/// Shipping company / carrier profile
model Carrier {
  id              String   @id @default(cuid())
  name            String
  legalName       String?
  taxId           String?  @unique
  commercialReg   String?

  contactEmail    String?
  contactPhone    String?
  contactPerson   String?

  // Fleet info
  fleetSize       Int?
  hasReefer       Boolean  @default(false)   // Cold chain capable
  hasFrozen       Boolean  @default(false)   // -18°C
  hasChilled      Boolean  @default(false)   // 2-8°C

  // Coverage
  coverageAreas   String?  // JSON array of governorates

  // Status
  status          CarrierStatus @default(PENDING_VERIFICATION)
  reliabilityScore Float?  @default(0)  // 0-100
  rating          Float?  @default(0)

  // Financial
  bankAccount     String?
  bankName        String?
  paymentTerms    String   @default("NET_48")

  // Relations
  users           User[]
  rates           CarrierRate[]
  deliveryJobs    DeliveryJob[]
  trips           Trip[]

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documents       Document[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([tenantId])
}

/// Carrier rate card per route/zone
model CarrierRate {
  id              String   @id @default(cuid())
  carrierId       String
  carrier         Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  // Route
  fromGovernorate String
  toGovernorate   String
  fromCity        String?
  toCity          String?

  // Pricing
  rateType        CarrierRateType @default(PER_KG)
  baseRate        Decimal
  minCharge       Decimal?
  fuelSurcharge   Decimal?  @default(0)  // Percentage
  currency        String   @default("EGP")

  // Conditions
  minWeight       Decimal?
  maxWeight       Decimal?
  estimatedDays   Int?

  // Temperature zone
  temperatureZone TemperatureZone @default(AMBIENT)

  validFrom       DateTime @default(now())
  validUntil      DateTime?
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([carrierId, fromGovernorate, toGovernorate])
}

/// Individual delivery job assigned to a carrier
model DeliveryJob {
  id              String   @id @default(cuid())
  jobNumber       String   @unique

  carrierId       String
  carrier         Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  // What's being delivered
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Link to trip if consolidated
  tripId          String?
  trip            Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripStopId      String?
  tripStop        TripStop? @relation(fields: [tripStopId], references: [id], onDelete: SetNull)

  // Pickup
  pickupAddress   String
  pickupContact   String?
  pickupPhone     String?
  pickupDate      DateTime?
  pickedUpAt      DateTime?

  // Delivery
  deliveryAddress String
  deliveryContact String?
  deliveryPhone   String?
  deliveryDate    DateTime?
  deliveredAt     DateTime?

  // Status
  status          DeliveryJobStatus @default(ASSIGNED)

  // Financial
  shippingCost    Decimal
  platformFee     Decimal   @default(0)  // 5-10% commission
  carrierPayout   Decimal   @default(0)  // shippingCost - platformFee
  currency        String    @default("EGP")
  paidToCarrier   Boolean   @default(false)
  carrierPaidAt   DateTime?

  // POD
  podPhotoUrl     String?
  signatureUrl    String?
  otpDeliveryId   String?
  otpDelivery     OtpDelivery? @relation(fields: [otpDeliveryId], references: [id])

  // Temperature monitoring (IoT)
  temperatureLog  String?   // JSON: [{ time, temp, location }, ...]
  tempViolation   Boolean   @default(false)

  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([carrierId, status])
  @@index([orderId])
  @@index([status, deliveryDate])
}

enum CarrierStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum CarrierRateType {
  PER_KG
  PER_KM
  PER_TRIP
  FLAT_RATE
}

enum TemperatureZone {
  AMBIENT
  CHILLED
  FROZEN
}

enum DeliveryJobStatus {
  ASSIGNED
  ACCEPTED_BY_CARRIER
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

// ─────────────────────────────────────────
// F. ERP/PMS INTEGRATION LAYER
// ─────────────────────────────────────────

/// Integration configuration for hotel ERP/PMS systems
model Integration {
  id              String   @id @default(cuid())

  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // What system
  integrationType IntegrationType
  providerName    String   // "Oracle Opera Cloud", "Protel", "SAP", "Manual"

  // Connection config (encrypted)
  config          String   // JSON: { "apiUrl": "...", "clientId": "...", ... }
  credentials     String?  // Encrypted credentials

  // Sync settings
  syncDirection   SyncDirection @default(BIDIRECTIONAL)
  syncFrequency   SyncFrequency @default(HOURLY)
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  isActive        Boolean  @default(true)

  // Field mapping (for CSV/Excel)
  fieldMapping    String?  // JSON: { "product_name": "item_desc", "price": "unit_cost", ... }

  // Relations
  logs            ConnectorLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, integrationType])
}

/// Sync log for debugging and audit
model ConnectorLog {
  id              String   @id @default(cuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  syncType        String   // "product_import", "order_export", "invoice_sync"
  direction       String   // "inbound", "outbound"
  status          String   // "success", "error", "partial"
  recordsProcessed Int?
  recordsFailed   Int?
  errorMessage    String?
  details         String?  // JSON

  startedAt       DateTime
  completedAt     DateTime?

  createdAt       DateTime @default(now())

  @@index([integrationId, createdAt])
}

enum IntegrationType {
  OPERA_CLOUD
  OPERA_ON_PREMISE
  PROTEL
  SAP
  ORACLE_ERP
  SUN_FINANCE
  CSV_EXCEL
  API_DIRECT
  MANUAL
}

enum SyncDirection {
  INBOUND      // From ERP to HotelsVendors
  OUTBOUND     // From HotelsVendors to ERP
  BIDIRECTIONAL
}

enum SyncFrequency {
  REALTIME
  EVERY_15_MIN
  HOURLY
  DAILY
  WEEKLY
  MANUAL
}

// ─────────────────────────────────────────
// G. SUPPLIER AUTO-ACCEPT RULES
// ─────────────────────────────────────────

/// Rules for auto-accepting orders without manual review
model SupplierAutoAcceptRule {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isActive        Boolean  @default(true)

  // Conditions
  maxOrderAmount  Decimal?        // Auto-accept if order total <= this
  maxQuantity     Json?           // { "kg": 500, "pieces": 1000 }
  categories      ProductCategory[]  // Only auto-accept these categories
  excludedProducts String?        // JSON array of product IDs to exclude

  // Auto-pricing
  useListedPrice  Boolean  @default(true)
  autoDiscount    Json?    // { "threshold": 1000, "discountPercent": 5 }

  // Notifications
  notifyOnAutoAccept Boolean @default(true)
  alertOnLargeOrder  Boolean  @default(true)
  largeOrderThreshold Decimal?

  // Red flags that override auto-accept
  redFlags        String?  // JSON: { "newHotel": true, "unusualQuantity": true, "priceBelowCost": true }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────
// H. API KEY MANAGEMENT
// ─────────────────────────────────────────

/// API keys for supplier/marketplace integrations
model ApiKey {
  id              String   @id @default(cuid())
  keyHash         String   @unique  // Hashed key (never store plaintext)
  keyPrefix       String   // First 8 chars for identification (e.g., "hv_live_")

  name            String   // "Cartona Integration", "Supplier X API"
  description     String?

  // Who owns it
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Scopes
  scopes          String[] // ["products:read", "products:write", "orders:read", "invoices:write"]

  // Rate limiting
  rateLimitPerMinute Int @default(60)

  // Status
  status          ApiKeyStatus @default(ACTIVE)
  lastUsedAt      DateTime?
  expiresAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([supplierId])
  @@index([tenantId])
  @@index([keyPrefix])
}

/// Webhook endpoints for integrations
model WebhookEndpoint {
  id              String   @id @default(cuid())
  url             String
  secret          String   // For HMAC signature verification

  // What events to send
  events          String[] // ["order.created", "order.delivered", "invoice.validated"]

  // Who owns it
  apiKeyId        String?
  apiKey          ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Status
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([apiKeyId])
  @@index([supplierId])
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ─────────────────────────────────────────
// I. FRAUD DETECTION
// ─────────────────────────────────────────

/// Fraud detection rules
model FraudRule {
  id              String   @id @default(cuid())
  name            String
  description     String?
  ruleType        FraudRuleType

  // Rule config
  config          String   // JSON: { "threshold": 1.2, "lookbackDays": 30 }

  severity        FraudSeverity @default(MEDIUM)
  isActive        Boolean  @default(true)

  // Auto-action
  autoAction      FraudAutoAction @default(ALERT_ONLY)

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  alerts          FraudAlert[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Fraud alerts triggered by rules
model FraudAlert {
  id              String   @id @default(cuid())
  ruleId          String
  rule            FraudRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // What triggered it
  entityType      String   // "Invoice", "Order", "Supplier"
  entityId        String
  description     String
  evidence        String?  // JSON

  severity        FraudSeverity
  status          FraudAlertStatus @default(OPEN)

  // Resolution
  resolvedById    String?
  resolvedAt      DateTime?
  resolution      String?

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([status, severity])
}

enum FraudRuleType {
  PRICE_ANOMALY        // Invoice price > X% above market
  DUPLICATE_INVOICE    // Same invoice submitted twice
  UNUSUAL_ORDER        // Order quantity > X times normal
  PHANTOM_SUPPLIER     // Supplier with no verification
  RAPID_FIRE           // Multiple orders in short time
  CIRCULAR_TRADING     // Same entities trading back and forth
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAutoAction {
  ALERT_ONLY
  FLAG_FOR_REVIEW
  BLOCK_TRANSACTION
  SUSPEND_ENTITY
}

enum FraudAlertStatus {
  OPEN
  UNDER_INVESTIGATION
  CONFIRMED_FRAUD
  FALSE_POSITIVE
  RESOLVED
}

// ─────────────────────────────────────────
// J. VIRTUAL ACCOUNTS & DYNAMIC DISCOUNTING
// ─────────────────────────────────────────

/// Virtual settlement account for each hotel
model VirtualAccount {
  id              String   @id @default(cuid())
  accountNumber   String   @unique

  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Balance tracking (informational only — actual money is in bank)
  balance         Decimal  @default(0)
  currency        String   @default("EGP")

  // Linked bank account
  bankName        String?
  bankAccountNumber String?

  status          VirtualAccountStatus @default(ACTIVE)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId])
}

/// Dynamic discount offer — supplier offers discount for early payment
model DynamicDiscountOffer {
  id              String   @id @default(cuid())

  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Offer terms
  originalDueDate DateTime
  earlyPayDate    DateTime
  discountPercent Decimal
  discountAmount  Decimal
  earlyPayAmount  Decimal

  status          DiscountOfferStatus @default(PENDING)

  // If hotel accepts
  acceptedAt      DateTime?
  paidAt          DateTime?

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
}

/// Cash flow forecast for hotels
model CashFlowForecast {
  id              String   @id @default(cuid())

  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  forecastDate    DateTime
  period          String   // "2026-07", "2026-Q3"

  // Predicted
  expectedOutflows Decimal  // Upcoming payments
  expectedInflows  Decimal  // Expected revenue (if applicable)
  netPosition      Decimal

  // Recommendations
  recommendations  String?  // JSON: { "factorInvoices": [...], "delayPayments": [...] }

  // Actual (filled in later for accuracy tracking)
  actualOutflows   Decimal?
  accuracyScore    Float?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([hotelId, period])
}

enum VirtualAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DiscountOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  PAID
}

